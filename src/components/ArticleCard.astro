---
import type { ArticleData } from '../data/articles';
import { CAT_TEAM, UI_TEXT } from '../data/i18n';

interface Props {
  article: ArticleData;
}

const { article } = Astro.props;
const cat = CAT_TEAM[article.featuredCat] || CAT_TEAM.marc;
const catLabel = UI_TEXT.categories[article.category];
const typeLabel = UI_TEXT.articleTypes[article.articleType];
---

<article class="article-card" data-category={article.category}>
  <div class="card-media">
    <a href={`/articles/${article.slug}/`} class="media-link" tabindex="-1" aria-hidden="true">
      <img src={article.heroImage} alt={article.locales.ja.title} class="card-img" loading="lazy" />
    </a>
    <div class="card-badges">
      <a
        href={`/articles/category/${article.category}/`}
        class="badge cat-badge cat-badge-link"
        style={`background: ${cat.badgeColor}; color: #fff;`}
        title={`${catLabel.ja} の記事一覧を見る`}
      >
        <span data-i18n="ja">{catLabel.ja}</span>
        <span data-i18n="ca">{catLabel.ca}</span>
        <span data-i18n="en">{catLabel.en}</span>
      </a>
      <span class="badge type-badge">
        <span data-i18n="ja">{typeLabel.ja}</span>
        <span data-i18n="ca">{typeLabel.ca}</span>
        <span data-i18n="en">{typeLabel.en}</span>
      </span>
    </div>
  </div>

  <div class="card-content">
    <div class="card-meta">
      <span class="meta-date racing-font">📅 {article.publishedAt}</span>
      <span class="meta-circuit">📍 {article.circuit}</span>
    </div>

    <h3 class="card-title">
      <a href={`/articles/${article.slug}/`} class="stretched-link">
        <span data-i18n="ja">{article.locales.ja.title}</span>
        <span data-i18n="ca">{article.locales.ca.title}</span>
        <span data-i18n="en">{article.locales.en.title}</span>
      </a>
    </h3>

    <p class="card-summary">
      <span data-i18n="ja">{article.locales.ja.summary}</span>
      <span data-i18n="ca">{article.locales.ca.summary}</span>
      <span data-i18n="en">{article.locales.en.summary}</span>
    </p>

    <div class="card-highlight">
      <span class="hl-icon">⚡</span>
      <p class="hl-text">
        <span data-i18n="ja">{article.locales.ja.highlightPoint}</span>
        <span data-i18n="ca">{article.locales.ca.highlightPoint}</span>
        <span data-i18n="en">{article.locales.en.highlightPoint}</span>
      </p>
    </div>

    {article.tags && article.tags.length > 0 && (
      <div class="card-tags">
        {article.tags.slice(0, 3).map((tag) => (
          <a
            href={`/articles/tag/${encodeURIComponent(tag)}/`}
            class="card-tag-pill"
            title={`#${tag} の記事一覧を見る`}
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <div class="card-footer">
      <div class="reporter-chip">
        <img src={cat.image} alt={cat.name.en} class="reporter-avatar" />
        <div class="reporter-info">
          <span class="reporter-label">
            <span data-i18n="ja">担当猫記者</span>
            <span data-i18n="ca">Redactor felí</span>
            <span data-i18n="en">Cat Reporter</span>
          </span>
          <span class="reporter-name">
            <span data-i18n="ja">{cat.name.ja}</span>
            <span data-i18n="ca">{cat.name.ca}</span>
            <span data-i18n="en">{cat.name.en}</span>
          </span>
        </div>
      </div>

      <a href={`/articles/${article.slug}/`} class="read-more-btn racing-font">
        <span data-i18n="ja">記事を読む →</span>
        <span data-i18n="ca">Llegir més →</span>
        <span data-i18n="en">Read Report →</span>
      </a>
    </div>
  </div>
</article>

<style>
  .article-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 183, 3, 0.4);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45);
  }

  .card-media {
    position: relative;
    height: 210px;
    overflow: hidden;
    background: #10131a;
  }

  .media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .article-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: space-between;
    pointer-events: none;
  }

  .card-badges > * {
    pointer-events: auto;
  }

  .cat-badge-link {
    position: relative;
    z-index: 2;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  }

  .cat-badge-link:hover {
    transform: translateY(-2px) scale(1.04);
    filter: brightness(1.2);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.5);
  }

  .type-badge {
    position: relative;
    z-index: 2;
    background: rgba(13, 15, 20, 0.85);
    backdrop-filter: blur(6px);
    color: var(--accent-gold);
    border: 1px solid rgba(255, 183, 3, 0.35);
  }

  .card-content {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--text-muted);
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .meta-circuit {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.45;
    color: var(--text-primary);
  }

  .stretched-link {
    color: inherit;
    text-decoration: none;
  }

  .stretched-link::after {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    content: '';
  }

  .stretched-link:hover {
    color: var(--accent-gold);
  }

  .card-summary {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card-highlight {
    margin-top: auto;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    background: rgba(255, 183, 3, 0.08);
    border-left: 3px solid var(--accent-gold);
    padding: 0.6rem 0.75rem;
    border-radius: 0 0.45rem 0.45rem 0;
    font-size: 0.8rem;
    color: #ffe599;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    position: relative;
    z-index: 2;
    padding-top: 0.25rem;
  }

  .card-tag-pill {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .card-tag-pill:hover {
    color: var(--accent-gold);
    border-color: rgba(255, 183, 3, 0.45);
    background: rgba(255, 183, 3, 0.12);
    transform: translateY(-1px);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-subtle);
    position: relative;
    z-index: 2;
  }

  .reporter-chip {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .reporter-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-gold);
  }

  .reporter-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .reporter-label {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .reporter-name {
    font-size: 0.8rem;
    font-weight: 700;
  }

  .read-more-btn {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-red);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
  }

  .read-more-btn:hover {
    color: #ff758f;
    transform: translateX(2px);
  }
</style>
