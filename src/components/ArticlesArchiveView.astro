---
import Header from './Header.astro';
import ArticleCard from './ArticleCard.astro';
import Footer from './Footer.astro';
import type { ArticleData } from '../data/articles';
import { UI_TEXT, type Lang } from '../data/i18n';

interface Props {
  articles: ArticleData[];
  currentPage: number;
  totalPages: number;
  totalCount: number;
  pageSize?: number;
  activeCategory?: string;
  activeTag?: string;
  customTitle?: Record<Lang, string>;
  customSubtitle?: Record<Lang, string>;
  customBadge?: Record<Lang, string>;
  basePaginationPath?: string;
}

const {
  articles,
  currentPage,
  totalPages,
  totalCount,
  pageSize = 12,
  activeCategory = 'all',
  activeTag,
  customTitle,
  customSubtitle,
  customBadge,
  basePaginationPath
} = Astro.props;

const categories = ['all', 'motogp', 'sbk', 'kyushu', 'endurance-fun', 'maintenance', 'all-japan', 'spotlight'] as const;

const isCategoryView = activeCategory && activeCategory !== 'all' && !activeTag;
const isTagView = Boolean(activeTag);

const currentCatLabel = isCategoryView && activeCategory in UI_TEXT.categories
  ? UI_TEXT.categories[activeCategory as keyof typeof UI_TEXT.categories]
  : null;

const bannerBadge: Record<Lang, string> = customBadge || (
  isTagView
    ? UI_TEXT.archive.tagArchiveBadge
    : isCategoryView
      ? UI_TEXT.archive.categoryArchiveBadge
      : UI_TEXT.archive.badge
);

const bannerTitle: Record<Lang, string> = customTitle || (
  isTagView
    ? {
        ja: `🏷️ #${activeTag} の記事一覧`,
        ca: `🏷️ Articles de #${activeTag}`,
        en: `🏷️ Dispatches tagged #${activeTag}`
      }
    : isCategoryView && currentCatLabel
      ? {
          ja: `${currentCatLabel.ja} の記事一覧`,
          ca: `Articles de ${currentCatLabel.ca}`,
          en: `Dispatches: ${currentCatLabel.en}`
        }
      : UI_TEXT.archive.title
);

const bannerSubtitle: Record<Lang, string> = customSubtitle || (
  isTagView
    ? {
        ja: `タグ「#${activeTag}」が付けられたレースレポート・プレビュー・整備解説記事一覧（全 ${totalCount} 件）`,
        ca: `Cròniques, prèvies i guies tècniques amb l'etiqueta «#${activeTag}» (${totalCount} articles en total)`,
        en: `Race previews, official reports, and technical guides tagged with "#${activeTag}" (${totalCount} total dispatches)`
      }
    : isCategoryView && currentCatLabel
      ? {
          ja: `${currentCatLabel.ja} に関する公式ダイジェスト、プレビュー、技術解説記事一覧（全 ${totalCount} 件）`,
          ca: `Cròniques oficials, prèvies i anàlisi de ${currentCatLabel.ca} (${totalCount} articles)`,
          en: `Official reports, previews, and technical analyses for ${currentCatLabel.en} (${totalCount} total)`
        }
      : UI_TEXT.archive.subtitle
);

const startItem = totalCount > 0 ? (currentPage - 1) * pageSize + 1 : 0;
const endItem = Math.min(currentPage * pageSize, totalCount);

function getPageUrl(pageNum: number): string {
  const basePath = basePaginationPath
    ? (basePaginationPath.endsWith('/') ? basePaginationPath : `${basePaginationPath}/`)
    : (isCategoryView ? `/articles/category/${activeCategory}/` : isTagView ? `/articles/tag/${encodeURIComponent(activeTag!)}/` : '/articles/');

  if (pageNum === 1) return basePath;
  return `${basePath}page/${pageNum}/`;
}

function getCategoryUrl(catKey: string): string {
  if (catKey === 'all') return '/articles/';
  return `/articles/category/${catKey}/`;
}

const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<Header activeNav="articles" />

<main class="archive-main">
  <!-- Archive Header Banner -->
  <section class="archive-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <span data-i18n="ja">{UI_TEXT.archive.backToHome.ja}</span>
          <span data-i18n="ca">{UI_TEXT.archive.backToHome.ca}</span>
          <span data-i18n="en">{UI_TEXT.archive.backToHome.en}</span>
        </a>
        {(isCategoryView || isTagView) && (
          <>
            <span class="bc-sep">/</span>
            <a href="/articles/">
              <span data-i18n="ja">記事一覧</span>
              <span data-i18n="ca">Cròniques</span>
              <span data-i18n="en">Articles</span>
            </a>
            <span class="bc-sep">/</span>
            <span class="bc-current" aria-current="page">
              {isTagView && <span>#{activeTag}</span>}
              {isCategoryView && currentCatLabel && (
                <>
                  <span data-i18n="ja">{currentCatLabel.ja}</span>
                  <span data-i18n="ca">{currentCatLabel.ca}</span>
                  <span data-i18n="en">{currentCatLabel.en}</span>
                </>
              )}
            </span>
          </>
        )}
      </nav>

      <div class="banner-content">
        <div class="badge-row">
          <span class="badge hero-badge">
            <span data-i18n="ja">{bannerBadge.ja}</span>
            <span data-i18n="ca">{bannerBadge.ca}</span>
            <span data-i18n="en">{bannerBadge.en}</span>
          </span>
          {totalPages > 1 && (
            <span class="badge count-badge racing-font">
              PAGE {currentPage} / {totalPages}
            </span>
          )}
        </div>

        <h1 class="archive-title">
          <span data-i18n="ja">{bannerTitle.ja}</span>
          <span data-i18n="ca">{bannerTitle.ca}</span>
          <span data-i18n="en">{bannerTitle.en}</span>
        </h1>

        <p class="archive-subtitle">
          <span data-i18n="ja">{bannerSubtitle.ja}</span>
          <span data-i18n="ca">{bannerSubtitle.ca}</span>
          <span data-i18n="en">{bannerSubtitle.en}</span>
        </p>

        <div class="archive-metrics">
          <div class="metric-pill">
            <strong class="racing-font">TOTAL DISPATCHES</strong>
            <span>全 {totalCount} 件</span>
          </div>
          {totalCount > 0 && (
            <div class="metric-pill">
              <strong class="racing-font">SHOWING</strong>
              <span>{startItem}〜{endItem} 件目</span>
            </div>
          )}
          {totalPages > 1 && (
            <div class="metric-pill">
              <strong class="racing-font">CURRENT PAGE</strong>
              <span>{currentPage} / {totalPages} ページ</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Articles List Section with Category Filter -->
  <section class="archive-list-section">
    <div class="container">
      <div class="filter-bar">
        {isTagView && (
          <div class="tag-active-pill">
            <span class="tag-indicator-label">🏷️ 選択中のタグ:</span>
            <span class="tag-indicator-val">#{activeTag}</span>
            <a href="/articles/" class="tag-reset-link">すべての記事を見る ×</a>
          </div>
        )}

        <div class="category-filters" role="tablist" aria-label="Category Filter">
          {categories.map((catKey) => {
            const isSelected = isCategoryView ? activeCategory === catKey : (!isTagView && catKey === 'all');
            return (
              <a
                href={getCategoryUrl(catKey)}
                class={`filter-btn ${isSelected ? 'active' : ''}`}
                data-filter-category={catKey}
                role="tab"
                aria-selected={isSelected}
              >
                <span data-i18n="ja">{UI_TEXT.categories[catKey].ja}</span>
                <span data-i18n="ca">{UI_TEXT.categories[catKey].ca}</span>
                <span data-i18n="en">{UI_TEXT.categories[catKey].en}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Articles Grid -->
      {articles.length > 0 ? (
        <div class="articles-grid" id="articles-grid">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <div class="no-articles-card">
          <p class="no-articles-text">該当する記事はまだありません。</p>
          <a href="/articles/" class="btn-back-all">全記事一覧へ戻る</a>
        </div>
      )}

      <!-- Pagination Component -->
      {totalPages > 1 && (
        <nav class="pagination-nav" aria-label="Article Archive Pages">
          <div class="pagination-container">
            {prevUrl ? (
              <a href={prevUrl} class="page-btn page-arrow" rel="prev">
                <span data-i18n="ja">{UI_TEXT.archive.prevPage.ja}</span>
                <span data-i18n="ca">{UI_TEXT.archive.prevPage.ca}</span>
                <span data-i18n="en">{UI_TEXT.archive.prevPage.en}</span>
              </a>
            ) : (
              <span class="page-btn page-arrow disabled" aria-disabled="true">
                <span data-i18n="ja">{UI_TEXT.archive.prevPage.ja}</span>
                <span data-i18n="ca">{UI_TEXT.archive.prevPage.ca}</span>
                <span data-i18n="en">{UI_TEXT.archive.prevPage.en}</span>
              </span>
            )}

            <div class="page-numbers">
              {pageNumbers.map((num) => {
                const isCurrent = num === currentPage;
                return isCurrent ? (
                  <span class="page-num active racing-font" aria-current="page">
                    {num}
                  </span>
                ) : (
                  <a href={getPageUrl(num)} class="page-num racing-font">
                    {num}
                  </a>
                );
              })}
            </div>

            {nextUrl ? (
              <a href={nextUrl} class="page-btn page-arrow" rel="next">
                <span data-i18n="ja">{UI_TEXT.archive.nextPage.ja}</span>
                <span data-i18n="ca">{UI_TEXT.archive.nextPage.ca}</span>
                <span data-i18n="en">{UI_TEXT.archive.nextPage.en}</span>
              </a>
            ) : (
              <span class="page-btn page-arrow disabled" aria-disabled="true">
                <span data-i18n="ja">{UI_TEXT.archive.nextPage.ja}</span>
                <span data-i18n="ca">{UI_TEXT.archive.nextPage.ca}</span>
                <span data-i18n="en">{UI_TEXT.archive.nextPage.en}</span>
              </span>
            )}
          </div>
        </nav>
      )}
    </div>
  </section>
</main>

<Footer />



<style>
  .archive-main {
    padding-bottom: 4rem;
  }

  .archive-banner {
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(21, 25, 34, 0.6) 0%, transparent 100%);
  }

  .breadcrumb {
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: var(--accent-gold);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .bc-sep {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .bc-current {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .hero-badge {
    background: rgba(230, 57, 70, 0.16);
    color: #ff758f;
    border: 1px solid rgba(230, 57, 70, 0.35);
  }

  .count-badge {
    background: rgba(255, 183, 3, 0.15);
    color: var(--accent-gold);
    border: 1px solid rgba(255, 183, 3, 0.35);
  }

  .archive-title {
    font-size: clamp(1.65rem, 3.2vw, 2.45rem);
    font-weight: 900;
    line-height: 1.25;
    margin-bottom: 0.75rem;
  }

  .archive-subtitle {
    font-size: 0.98rem;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    max-width: 820px;
    line-height: 1.65;
  }

  .archive-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .metric-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: 0.65rem;
    padding: 0.55rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-pill strong {
    font-size: 0.72rem;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
  }

  .metric-pill span {
    font-size: 0.82rem;
    color: var(--text-primary);
  }

  .archive-list-section {
    padding: 2.75rem 0 2rem;
  }

  .filter-bar {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tag-active-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 183, 3, 0.1);
    border: 1px solid rgba(255, 183, 3, 0.35);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    width: fit-content;
    font-size: 0.85rem;
  }

  .tag-indicator-label {
    color: var(--text-muted);
  }

  .tag-indicator-val {
    color: var(--accent-gold);
    font-weight: 700;
  }

  .tag-reset-link {
    color: #ff758f;
    font-size: 0.78rem;
    text-decoration: none;
    margin-left: 0.35rem;
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: rgba(230, 57, 70, 0.15);
    transition: all 0.15s ease;
  }

  .tag-reset-link:hover {
    background: rgba(230, 57, 70, 0.3);
    color: #fff;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }

  .filter-btn.active {
    background: var(--accent-gold);
    color: #0d0f14;
    border-color: var(--accent-gold);
    box-shadow: 0 4px 12px rgba(255, 183, 3, 0.3);
  }

  .no-articles-card {
    background: var(--bg-card);
    border: 1px dashed var(--border-subtle);
    border-radius: 1rem;
    padding: 3rem 1.5rem;
    text-align: center;
    margin: 2rem 0;
  }

  .no-articles-text {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }

  .btn-back-all {
    display: inline-flex;
    align-items: center;
    background: var(--accent-gold);
    color: #0d0f14;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.55rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .btn-back-all:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.6rem;
  }

  .pagination-nav {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .pagination-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.15rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: all 0.18s ease;
  }

  .page-btn:not(.disabled):hover {
    background: var(--accent-gold);
    color: #0d0f14;
    border-color: var(--accent-gold);
  }

  .page-btn.disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-secondary);
    transition: all 0.18s ease;
  }

  .page-num:hover:not(.active) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .page-num.active {
    background: var(--accent-gold);
    color: #0d0f14;
    border-color: var(--accent-gold);
  }

  @media (max-width: 640px) {
    .pagination-container {
      gap: 0.5rem;
    }

    .page-btn {
      padding: 0.5rem 0.85rem;
      font-size: 0.8rem;
    }

    .page-num {
      min-width: 2.1rem;
      height: 2.1rem;
      font-size: 0.85rem;
    }
  }
</style>
