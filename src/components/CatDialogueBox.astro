---
import type { CatDialogue } from '../data/articles';
import { CAT_TEAM, type Lang } from '../data/i18n';

interface Props {
  dialogues: CatDialogue[];
  lang: Lang;
}

const { dialogues, lang } = Astro.props;
---

<div class="dialogue-container">
  <h3 class="dialogue-heading">
    {lang === 'ja' && '🐱 猫編集部のパドック裏話＆掛け合い'}
    {lang === 'ca' && '🐱 La Tertúlia Felina del Pàdoc'}
    {lang === 'en' && '🐱 Cat Editorial Paddock Banter'}
  </h3>

  <div class="dialogue-list">
    {dialogues.map((item) => {
      const cat = CAT_TEAM[item.speaker as keyof typeof CAT_TEAM] || CAT_TEAM.marc;
      return (
        <div class="dialogue-row">
          <div class="speaker-col">
            <img src={cat.image} alt={cat.name[lang]} class="speaker-avatar" style={`border-color: ${cat.badgeColor};`} />
          </div>
          <div class="bubble-col">
            <div class="bubble-header">
              <span class="speaker-name">{cat.name[lang]}</span>
              <span class="speaker-role">{cat.role[lang]}</span>
            </div>
            <p class="bubble-text">{item.text}</p>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .dialogue-container {
    margin-top: 2.5rem;
    background: rgba(21, 25, 34, 0.9);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 1.75rem;
  }

  .dialogue-heading {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 1.35rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .dialogue-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .dialogue-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.85rem;
    background: rgba(13, 15, 20, 0.65);
    border: 1px solid var(--border-subtle);
  }

  .speaker-avatar {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-gold);
    flex-shrink: 0;
  }

  .bubble-col {
    flex: 1;
  }

  .bubble-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .speaker-name {
    font-weight: 800;
    font-size: 0.92rem;
  }

  .speaker-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .bubble-text {
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--text-primary);
  }
</style>
