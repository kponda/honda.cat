---
import { UI_TEXT } from '../data/i18n';
---

<section id="catalunya-mission" class="catalunya-mission">
  <div class="container">
    <div class="mission-card">
      <div class="mission-flag-stripe"></div>
      <div class="mission-content">
        <span class="badge" style="background: rgba(255, 183, 3, 0.18); color: var(--accent-gold);">
          {UI_TEXT.catalunyaSection.badge}
        </span>
        <h2 class="mission-title">
          <span data-i18n="ja">{UI_TEXT.catalunyaSection.title.ja}</span>
          <span data-i18n="ca">{UI_TEXT.catalunyaSection.title.ca}</span>
          <span data-i18n="en">{UI_TEXT.catalunyaSection.title.en}</span>
        </h2>
        <p class="mission-body">
          <span data-i18n="ja">{UI_TEXT.catalunyaSection.body.ja}</span>
          <span data-i18n="ca">{UI_TEXT.catalunyaSection.body.ca}</span>
          <span data-i18n="en">{UI_TEXT.catalunyaSection.body.en}</span>
        </p>
        <div class="mission-links">
          <a href="/ca/" class="btn btn-secondary" onclick="window.setHondaCatLang && window.setHondaCatLang('ca')">
            🏴󠁥󠁳󠁣󠁴󠁿 Edició en Català (/ca/)
          </a>
          <a href="/" class="btn btn-secondary" onclick="window.setHondaCatLang && window.setHondaCatLang('ja')">
            🇯🇵 日本語版トップ (/)
          </a>
          <a href="/en/" class="btn btn-secondary" onclick="window.setHondaCatLang && window.setHondaCatLang('en')">
            🇬🇧 English Edition (/en/)
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="racing-font" style="font-size: 1.3rem; font-weight: 700;">
          🐾 HONDA<span style="color: var(--accent-gold);">.CAT</span>
        </span>
        <p class="footer-memory-note">
          <span data-i18n="ja">{UI_TEXT.footer.langMemoryNote.ja}</span>
          <span data-i18n="ca">{UI_TEXT.footer.langMemoryNote.ca}</span>
          <span data-i18n="en">{UI_TEXT.footer.langMemoryNote.en}</span>
        </p>
      </div>

      <div class="footer-circuits">
        <strong>Featured Tracks:</strong>
        <span>SPA直入 (Oita)</span> ·
        <span>Autopolis (Oita)</span> ·
        <span>HSR九州 (Kumamoto)</span> ·
        <span>Circuit de Barcelona-Catalunya</span> ·
        <span>Suzuka / Motegi / Tsukuba</span>
      </div>
    </div>

    <p class="footer-disclaimer">
      <span data-i18n="ja">{UI_TEXT.footer.disclaimer.ja}</span>
      <span data-i18n="ca">{UI_TEXT.footer.disclaimer.ca}</span>
      <span data-i18n="en">{UI_TEXT.footer.disclaimer.en}</span>
    </p>
  </div>
</footer>

<style>
  .catalunya-mission {
    padding: 3rem 0;
  }

  .mission-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    overflow: hidden;
  }

  /* Catalan Senyera 4 red stripes on gold */
  .mission-flag-stripe {
    height: 10px;
    background: repeating-linear-gradient(
      90deg,
      #ffb703 0px,
      #ffb703 24px,
      #e63946 24px,
      #e63946 48px
    );
  }

  .mission-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .mission-title {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .mission-body {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .mission-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .site-footer {
    margin-top: auto;
    background: #08090d;
    border-top: 1px solid var(--border-subtle);
    padding: 2.5rem 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-memory-note {
    margin-top: 0.35rem;
    color: var(--accent-gold);
    font-size: 0.8rem;
  }

  .footer-circuits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--text-secondary);
  }

  .footer-disclaimer {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    line-height: 1.6;
  }
</style>
