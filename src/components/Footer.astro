---
import { UI_TEXT } from '../data/i18n';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="racing-font" style="font-size: 1.3rem; font-weight: 700;">
          🐾 HONDA<span style="color: var(--accent-gold);">.CAT</span>
        </span>
        <p class="footer-memory-note">
          <span data-i18n="ja">{UI_TEXT.footer.langMemoryNote.ja}</span>
          <span data-i18n="ca">{UI_TEXT.footer.langMemoryNote.ca}</span>
          <span data-i18n="en">{UI_TEXT.footer.langMemoryNote.en}</span>
        </p>
      </div>

      <div class="footer-links">
        <a
          href="https://buymeacoffee.com/honda.cat"
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="footer-support-link"
        >
          <span data-i18n="ja">{UI_TEXT.churuSupport.footerButton.ja} ↗</span>
          <span data-i18n="ca">{UI_TEXT.churuSupport.footerButton.ca} ↗</span>
          <span data-i18n="en">{UI_TEXT.churuSupport.footerButton.en} ↗</span>
        </a>
        <a href="/about/" class="footer-about-link">
          <span data-i18n="ja">ℹ️ 当サイトについて（.cat カタルーニャ貢献・編集方針）</span>
          <span data-i18n="ca">ℹ️ Sobre nosaltres (Missió .cat i Política Editorial)</span>
          <span data-i18n="en">ℹ️ About honda.cat (.cat Mission & Editorial Policy)</span>
        </a>
      </div>
    </div>

    <div class="footer-circuits">
      <strong>Featured Tracks:</strong>
      <span>SPA直入 (Oita)</span> ·
      <span>Autopolis (Oita)</span> ·
      <span>HSR九州 (Kumamoto)</span> ·
      <span>Circuit de Barcelona-Catalunya</span> ·
      <span>Suzuka / Motegi / Tsukuba</span>
    </div>

    <p class="footer-disclaimer">
      <span data-i18n="ja">{UI_TEXT.footer.disclaimer.ja}</span>
      <span data-i18n="ca">{UI_TEXT.footer.disclaimer.ca}</span>
      <span data-i18n="en">{UI_TEXT.footer.disclaimer.en}</span>
    </p>

    <div class="footer-bottom">
      <div class="footer-operator">
        <span class="operator-label">
          <span data-i18n="ja">{UI_TEXT.footer.operatorLabel.ja}</span>
          <span data-i18n="ca">{UI_TEXT.footer.operatorLabel.ca}</span>
          <span data-i18n="en">{UI_TEXT.footer.operatorLabel.en}</span>
        </span>
        <a
          href="https://honda.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="operator-link"
        >
          <img
            src="/images/honda-denno-logo.png"
            alt="HONDA DENNO"
            class="operator-logo"
            width="18"
            height="16"
            loading="lazy"
          />
          <span data-i18n="ja">{UI_TEXT.footer.operatorName.ja}</span>
          <span data-i18n="ca">{UI_TEXT.footer.operatorName.ca}</span>
          <span data-i18n="en">{UI_TEXT.footer.operatorName.en}</span>
          <span class="operator-ext">↗</span>
        </a>
      </div>

      <div class="footer-copy">
        &copy; 2026 honda.cat
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: #090b0f;
    border-top: 1px solid var(--border-subtle);
    padding: 2.25rem 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-memory-note {
    margin-top: 0.25rem;
    color: var(--text-secondary);
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .footer-support-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 183, 3, 0.2) 0%, rgba(251, 133, 0, 0.25) 100%);
    border: 1px solid rgba(255, 183, 3, 0.5);
    color: var(--accent-gold);
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.15s ease;
  }

  .footer-support-link:hover {
    background: linear-gradient(135deg, #ffb703 0%, #fb8500 100%);
    color: #0d0f14;
    border-color: #ffb703;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 183, 3, 0.3);
  }

  .footer-about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 183, 3, 0.1);
    border: 1px solid rgba(255, 183, 3, 0.28);
    color: var(--accent-gold);
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.15s ease;
  }

  .footer-about-link:hover {
    background: rgba(255, 183, 3, 0.2);
    color: #fff;
  }

  .footer-circuits {
    color: var(--text-secondary);
  }

  .footer-disclaimer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    line-height: 1.6;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-operator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .operator-label {
    color: var(--text-muted);
  }

  .operator-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .operator-link:hover {
    color: var(--accent-gold);
  }

  .operator-logo {
    display: inline-block;
    height: 15px;
    width: auto;
    vertical-align: middle;
    opacity: 0.85;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .operator-link:hover .operator-logo {
    opacity: 1;
    transform: scale(1.08);
  }

  .operator-ext {
    font-size: 0.72rem;
    opacity: 0.65;
  }

  .footer-copy {
    color: var(--text-muted);
    font-size: 0.75rem;
  }
</style>
