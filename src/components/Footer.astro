---
import { UI_TEXT } from '../data/i18n';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="racing-font" style="font-size: 1.3rem; font-weight: 700;">
          🐾 HONDA<span style="color: var(--accent-gold);">.CAT</span>
        </span>
        <p class="footer-memory-note">
          <span data-i18n="ja">{UI_TEXT.footer.langMemoryNote.ja}</span>
          <span data-i18n="ca">{UI_TEXT.footer.langMemoryNote.ca}</span>
          <span data-i18n="en">{UI_TEXT.footer.langMemoryNote.en}</span>
        </p>
      </div>

      <div class="footer-links">
        <a href="/about/" class="footer-about-link">
          <span data-i18n="ja">ℹ️ 当サイトについて（.cat カタルーニャ貢献・編集方針）</span>
          <span data-i18n="ca">ℹ️ Sobre nosaltres (Missió .cat i Política Editorial)</span>
          <span data-i18n="en">ℹ️ About honda.cat (.cat Mission & Editorial Policy)</span>
        </a>
      </div>
    </div>

    <div class="footer-circuits">
      <strong>Featured Tracks:</strong>
      <span>SPA直入 (Oita)</span> ·
      <span>Autopolis (Oita)</span> ·
      <span>HSR九州 (Kumamoto)</span> ·
      <span>Circuit de Barcelona-Catalunya</span> ·
      <span>Suzuka / Motegi / Tsukuba</span>
    </div>

    <p class="footer-disclaimer">
      <span data-i18n="ja">{UI_TEXT.footer.disclaimer.ja}</span>
      <span data-i18n="ca">{UI_TEXT.footer.disclaimer.ca}</span>
      <span data-i18n="en">{UI_TEXT.footer.disclaimer.en}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: #090b0f;
    border-top: 1px solid var(--border-subtle);
    padding: 2.25rem 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-memory-note {
    margin-top: 0.25rem;
    color: var(--text-secondary);
  }

  .footer-about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(255, 183, 3, 0.1);
    border: 1px solid rgba(255, 183, 3, 0.28);
    color: var(--accent-gold);
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.15s ease;
  }

  .footer-about-link:hover {
    background: rgba(255, 183, 3, 0.2);
    color: #fff;
  }

  .footer-circuits {
    color: var(--text-secondary);
  }

  .footer-disclaimer {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    line-height: 1.6;
  }
</style>
