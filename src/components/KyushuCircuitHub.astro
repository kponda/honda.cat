---
import { UI_TEXT } from '../data/i18n';
---

<section id="kyushu-hub" class="kyushu-section">
  <div class="container">
    <div class="kyushu-banner">
      <div class="kyushu-header">
        <div class="kyushu-badges">
          <span class="badge" style="background: rgba(255, 183, 3, 0.18); color: var(--accent-gold); border: 1px solid rgba(255, 183, 3, 0.4);">
            OITA & KUMAMOTO SPECIAL FOCUS
          </span>
          <span class="badge" style="background: rgba(199, 125, 255, 0.18); color: #e0aaff; border: 1px solid rgba(199, 125, 255, 0.4);">
            SPA直入 · AUTOPOLIS · HSR九州 · お題付き耐久
          </span>
        </div>

        <h2 class="kyushu-title">
          <span data-i18n="ja">{UI_TEXT.kyushuHub.title.ja}</span>
          <span data-i18n="ca">{UI_TEXT.kyushuHub.title.ca}</span>
          <span data-i18n="en">{UI_TEXT.kyushuHub.title.en}</span>
        </h2>

        <p class="kyushu-subtitle">
          <span data-i18n="ja">{UI_TEXT.kyushuHub.subtitle.ja}</span>
          <span data-i18n="ca">{UI_TEXT.kyushuHub.subtitle.ca}</span>
          <span data-i18n="en">{UI_TEXT.kyushuHub.subtitle.en}</span>
        </p>
      </div>

      <div class="spots-grid">
        {UI_TEXT.kyushuHub.spots.map((spot) => (
          <div class={`spot-card spot-${spot.id}`}>
            <div class="spot-top">
              <span class="spot-badge racing-font">{spot.badge}</span>
            </div>
            <h3 class="spot-name">
              <span data-i18n="ja">{spot.name.ja}</span>
              <span data-i18n="ca">{spot.name.ca}</span>
              <span data-i18n="en">{spot.name.en}</span>
            </h3>
            <div class="spot-spec">
              <span data-i18n="ja">{spot.spec.ja}</span>
              <span data-i18n="ca">{spot.spec.ca}</span>
              <span data-i18n="en">{spot.spec.en}</span>
            </div>
            <p class="spot-desc">
              <span data-i18n="ja">{spot.desc.ja}</span>
              <span data-i18n="ca">{spot.desc.ca}</span>
              <span data-i18n="en">{spot.desc.en}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .kyushu-section {
    padding: 4rem 0;
  }

  .kyushu-banner {
    background: linear-gradient(145deg, rgba(27, 32, 44, 0.95), rgba(21, 25, 34, 0.98));
    border: 1px solid rgba(255, 183, 3, 0.28);
    border-radius: 1.25rem;
    padding: 2.5rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .kyushu-header {
    max-width: 820px;
    margin-bottom: 2.2rem;
  }

  .kyushu-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .kyushu-title {
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
    font-weight: 900;
    margin-bottom: 0.6rem;
  }

  .kyushu-subtitle {
    color: var(--text-secondary);
    font-size: 0.96rem;
  }

  .spots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .spot-card {
    background: rgba(13, 15, 20, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .spot-card:hover {
    border-color: var(--accent-gold);
    transform: translateY(-3px);
  }

  .spot-odai-endurance {
    border-color: rgba(199, 125, 255, 0.4);
    background: linear-gradient(160deg, rgba(199, 125, 255, 0.1), rgba(13, 15, 20, 0.75));
  }

  .spot-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.07em;
  }

  .spot-odai-endurance .spot-badge {
    color: #e0aaff;
  }

  .spot-name {
    font-size: 1.12rem;
    font-weight: 800;
  }

  .spot-spec {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-teal);
    background: rgba(42, 157, 143, 0.12);
    padding: 0.3rem 0.55rem;
    border-radius: 0.35rem;
  }

  .spot-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .kyushu-banner {
      padding: 1.5rem;
    }
  }
</style>
