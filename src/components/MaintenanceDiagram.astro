---
import type { Lang } from '../data/i18n';
import type { LocalizedDiagram } from '../data/articles';

interface Props {
  slug: string;
  lang: Lang;
  contentDiagram?: LocalizedDiagram;
}

const { slug, lang, contentDiagram } = Astro.props;

const staticSlugs = [
  'circuit-maintenance-wire-locking-safety-wire-technique',
  'circuit-maintenance-brake-fluid-boiling-point-vapor-lock',
  'circuit-maintenance-tire-pressure-hot-management-physics',
  'circuit-maintenance-drive-chain-slack-suspension-geometry',
  'circuit-maintenance-torque-wrench-bolt-tension-mechanics',
  'circuit-maintenance-race-coolant-pure-water-mfj-rules'
];
const isStatic = staticSlugs.includes(slug);
---

{slug === 'circuit-maintenance-wire-locking-safety-wire-technique' && (
  <figure class="tech-diagram-figure" data-i18n={lang}>
    <div class="diagram-header">
      <span class="diagram-tag racing-font">🔧 TECHNICAL ILLUSTRATION</span>
      <h3 class="diagram-title">
        {lang === 'ja' && '【図解】安全ワイヤリングの締まり方向力学とピッグテール端末処理'}
        {lang === 'ca' && '【Esquema Tècnic】Física de Tracció Horària i Acabat Pigtail de Seguretat'}
        {lang === 'en' && '【Technical Diagram】Positive Tightening Tension Vector & Pigtail Safety Termination'}
      </h3>
      <p class="diagram-caption">
        {lang === 'ja' && 'ボルトが緩もうとする回転力を物理的に即座に抑え込む「時計回りテンション」の幾何学と端末処理'}
        {lang === 'ca' && 'Geometria de bloqueig mecànic que impedeix el gir antihorari del cargol i protecció a boxs'}
        {lang === 'en' && 'Mechanical lock geometry that counteracts unthreading torque with positive clockwise tension'}
      </p>
    </div>

    <div class="diagram-grid">
      <!-- Panel 1: Correct Tension -->
      <div class="diagram-card good-card">
        <div class="card-status good-status">
          <span class="status-icon">⭕</span>
          <strong>
            {lang === 'ja' && '合格：時計回り（締まり方向）'}
            {lang === 'ca' && 'Correcte: Sentit Horari'}
            {lang === 'en' && 'PASS: Clockwise Tension'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <!-- Background grid -->
          <defs>
            <radialGradient id="goodGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#2a9d8f" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#2a9d8f" stop-opacity="0"/>
            </radialGradient>
            <marker id="arrowGood" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="#2a9d8f" />
            </marker>
          </defs>
          <circle cx="110" cy="110" r="85" fill="url(#goodGlow)" />
          
          <!-- Bolt Hexagon Head -->
          <polygon points="110,45 166,77 166,143 110,175 54,143 54,77" fill="#1b202c" stroke="#4895ef" stroke-width="4" />
          <circle cx="110" cy="110" r="28" fill="#151922" stroke="#4895ef" stroke-width="2" />
          <!-- Drill hole -->
          <circle cx="140" cy="85" r="5" fill="#ffd166" stroke="#fff" stroke-width="1.5" />
          <text x="110" y="115" text-anchor="middle" fill="#f4f6fb" font-size="12" font-family="'Chakra Petch', sans-serif" font-weight="700">M12 DRAIN</text>

          <!-- Rotation Direction -->
          <path d="M 70,60 A 60 60 0 0 1 150,60" fill="none" stroke="#ffb703" stroke-width="2.5" stroke-dasharray="4,4" marker-end="url(#arrowGood)" />
          <text x="110" y="40" text-anchor="middle" fill="#ffb703" font-size="11" font-weight="700">↻ TIGHTEN (締結方向)</text>

          <!-- Safety Wire Vector (45-60 deg) -->
          <path d="M 140,85 Q 210,80 290,105" fill="none" stroke="#2a9d8f" stroke-width="4" stroke-linecap="round" />
          <!-- Twisted wire marks -->
          <path d="M 170,82 L 176,90 M 190,83 L 196,91 M 210,85 L 216,93 M 230,88 L 236,96 M 250,92 L 256,100 M 270,97 L 276,105" stroke="#a8b3cf" stroke-width="2" />
          
          <!-- Anchor Post -->
          <rect x="285" y="90" width="16" height="30" rx="3" fill="#3a4055" stroke="#f4f6fb" stroke-width="2" />
          <text x="293" y="135" text-anchor="middle" fill="#a8b3cf" font-size="10">STAY / ANCHOR</text>

          <!-- Tension label -->
          <text x="215" y="70" text-anchor="middle" fill="#2a9d8f" font-size="11" font-weight="700">TENSION 45°〜60°</text>
        </svg>
        <p class="card-desc">
          {lang === 'ja' && 'ボルトが反時計回りに緩もうとすると、ワイヤーが即座に引かれて回転を強力に物理阻止。車検合格の基本形！'}
          {lang === 'ca' && 'Si el cargol intenta afluixar-se (antihorari), el filferro s\'estira i bloqueja la rotació immediatament. Inspecció apta!'}
          {lang === 'en' && 'If the fastener attempts to unthread counterclockwise, wire tension physically counteracts it immediately. Scrutineering pass!'}
        </p>
      </div>

      <!-- Panel 2: Incorrect Reverse Tension -->
      <div class="diagram-card bad-card">
        <div class="card-status bad-status">
          <span class="status-icon">❌</span>
          <strong>
            {lang === 'ja' && '不合格：反時計回り（緩め方向）'}
            {lang === 'ca' && 'Rebutjat: Sentit Antihorari'}
            {lang === 'en' && 'REJECT: Counterclockwise'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <defs>
            <radialGradient id="badGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#e63946" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#e63946" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <circle cx="110" cy="110" r="85" fill="url(#badGlow)" />
          
          <!-- Bolt Hexagon Head -->
          <polygon points="110,45 166,77 166,143 110,175 54,143 54,77" fill="#1b202c" stroke="#e63946" stroke-width="4" />
          <circle cx="110" cy="110" r="28" fill="#151922" stroke="#e63946" stroke-width="2" />
          <!-- Drill hole on opposite side -->
          <circle cx="80" cy="135" r="5" fill="#ffd166" stroke="#fff" stroke-width="1.5" />
          <text x="110" y="115" text-anchor="middle" fill="#f4f6fb" font-size="12" font-family="'Chakra Petch', sans-serif" font-weight="700">M12 DRAIN</text>

          <!-- Safety Wire Pulling in LOOSENING direction -->
          <path d="M 80,135 Q 180,170 290,130" fill="none" stroke="#e63946" stroke-width="4" stroke-dasharray="6,4" stroke-linecap="round" />
          <rect x="285" y="115" width="16" height="30" rx="3" fill="#3a4055" stroke="#f4f6fb" stroke-width="2" />

          <!-- Warning text -->
          <text x="195" y="185" text-anchor="middle" fill="#ff758f" font-size="11" font-weight="700">⚠️ 緩み促進ワイヤー！</text>
          <text x="195" y="202" text-anchor="middle" fill="#ff758f" font-size="9">LOOSENING ASSIST VECTOR</text>
        </svg>
        <p class="card-desc">
          {lang === 'ja' && '反時計回りに引っ張ると、エンジンの高回転振動でボルトが緩む力をワイヤーが手助けしてしまいます。車検一発失格！'}
          {lang === 'ca' && 'Estirar cap a l\'esquerra acompanya el cargol a afluixar-se amb les vibracions. No apte immediat!'}
          {lang === 'en' && 'Routing counterclockwise assists unthreading under engine vibration, creating a dangerous loosening hazard.'}
        </p>
      </div>

      <!-- Panel 3: Pitch & Pigtail -->
      <div class="diagram-card detail-card">
        <div class="card-status detail-status">
          <span class="status-icon">📐</span>
          <strong>
            {lang === 'ja' && 'ピッチ規格＆ピッグテール端末'}
            {lang === 'ca' && 'Pas de Torsió i Remat Pigtail'}
            {lang === 'en' && 'Twist Pitch & Safe Pigtail'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <!-- 1-Inch Guideline -->
          <line x1="40" y1="50" x2="200" y2="50" stroke="#ffb703" stroke-width="2" />
          <line x1="40" y1="42" x2="40" y2="58" stroke="#ffb703" stroke-width="2" />
          <line x1="200" y1="42" x2="200" y2="58" stroke="#ffb703" stroke-width="2" />
          <text x="120" y="38" text-anchor="middle" fill="#ffb703" font-size="11" font-weight="700">1 INCH (25.4mm)</text>
          
          <!-- Twisted wire with 7 twists -->
          <g transform="translate(40, 70)">
            <path d="M 0,15 Q 12,5 24,15 T 48,15 T 72,15 T 96,15 T 120,15 T 144,15 T 160,15" fill="none" stroke="#f4f6fb" stroke-width="3" />
            <path d="M 0,15 Q 12,25 24,15 T 48,15 T 72,15 T 96,15 T 120,15 T 144,15 T 160,15" fill="none" stroke="#4895ef" stroke-width="3" />
          </g>
          <text x="120" y="110" text-anchor="middle" fill="#a8b3cf" font-size="11">理想ピッチ：6〜8 twists / inch</text>

          <!-- Pigtail folding diagram -->
          <g transform="translate(180, 130)">
            <rect x="0" y="0" width="120" height="70" rx="6" fill="#151922" stroke="#c77dff" stroke-width="1.5" />
            <text x="60" y="20" text-anchor="middle" fill="#c77dff" font-size="10" font-weight="700">PIGTAIL (豚の尻尾)</text>
            <!-- Inward curled wire -->
            <path d="M 20,45 Q 60,45 80,45 Q 95,45 95,35 Q 95,25 80,30" fill="none" stroke="#2a9d8f" stroke-width="3" stroke-linecap="round" />
            <circle cx="80" cy="30" r="3" fill="#ffd166" />
            <text x="60" y="62" text-anchor="middle" fill="#f4f6fb" font-size="9">先端5mmを内側へ巻き込む</text>
          </g>

          <text x="90" y="155" fill="#f4f6fb" font-size="11" font-weight="700">線径規格 (SUS304)</text>
          <text x="90" y="175" fill="#a8b3cf" font-size="10">・0.8mm: オイルドレン/フィルター</text>
          <text x="90" y="195" fill="#a8b3cf" font-size="10">・0.6mm: キャリパー/小径ボルト</text>
        </svg>
        <p class="card-desc">
          {lang === 'ja' && '撚りすぎは金属疲労破断の元。切断端部は必ず5mm残して内側に丸め、メカの手の裂傷事故をゼロに！'}
          {lang === 'ca' && 'El sobre-trenat causa microfissures. Doblegueu la punta 5 mm cap a dins per evitar punxades greus.'}
          {lang === 'en' && 'Over-twisting causes work-hardening fatigue. Always fold the 5mm tip inward to protect hands from punctures.'}
        </p>
      </div>
    </div>
  </figure>
)}

{slug === 'circuit-maintenance-brake-fluid-boiling-point-vapor-lock' && (
  <figure class="tech-diagram-figure" data-i18n={lang}>
    <div class="diagram-header">
      <span class="diagram-tag racing-font">🔧 TECHNICAL ILLUSTRATION</span>
      <h3 class="diagram-title">
        {lang === 'ja' && '【図解】ブレーキフルード沸点低下とベーパーロックのメカニズム'}
        {lang === 'ca' && '【Esquema Tècnic】Caiguda del Punt d\'Ebullició i Física del Vapor Lock'}
        {lang === 'en' && '【Technical Diagram】Brake Fluid Boiling Thresholds & Hydraulic Vapor Lock Mechanism'}
      </h3>
      <p class="diagram-caption">
        {lang === 'ja' && '水分わずか3.7%で沸点が75℃急落！キャリパー内200℃の極限熱と気泡圧縮による油圧喪失の全貌'}
        {lang === 'ca' && 'Com un 3,7% d\'humitat fa caure el punt d\'ebullició en 75°C per sota de la temperatura de la pinça'}
        {lang === 'en' && 'How 3.7% moisture drops boiling resistance by 75°C below caliper operating temperatures'}
      </p>
    </div>

    <div class="diagram-grid">
      <!-- Thermometer Boiling Points -->
      <div class="diagram-card detail-card">
        <div class="card-status detail-status">
          <span class="status-icon">🌡️</span>
          <strong>
            {lang === 'ja' && 'JIS K 2233 / DOT4 沸点メーター'}
            {lang === 'ca' && 'Escala de Punts d\'Ebullició'}
            {lang === 'en' && 'Boiling Point Spectrum'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <!-- Thermometer scale background -->
          <rect x="50" y="25" width="220" height="24" rx="4" fill="#1b202c" stroke="#3a4055" />
          <rect x="50" y="75" width="220" height="24" rx="4" fill="#1b202c" stroke="#3a4055" />
          <rect x="50" y="125" width="220" height="24" rx="4" fill="#1b202c" stroke="#3a4055" />
          <rect x="50" y="175" width="220" height="24" rx="4" fill="#1b202c" stroke="#3a4055" />

          <!-- Filled indicator bars -->
          <rect x="50" y="25" width="210" height="24" rx="4" fill="#7209b7" opacity="0.85" />
          <rect x="50" y="75" width="165" height="24" rx="4" fill="#2a9d8f" opacity="0.85" />
          <rect x="50" y="125" width="145" height="24" rx="4" fill="#ffb703" opacity="0.85" />
          <rect x="50" y="175" width="95" height="24" rx="4" fill="#e63946" opacity="0.85" />

          <!-- Values and Labels -->
          <text x="60" y="41" fill="#fff" font-size="11" font-weight="700">328℃: Racing DOT4 (水分0% 新品)</text>
          <text x="60" y="91" fill="#fff" font-size="11" font-weight="700">230℃: DOT4 ドライ沸点 (JIS規格基準)</text>
          <text x="60" y="141" fill="#1b202c" font-size="11" font-weight="900">180〜220℃: キャリパー実測温度 ⚠️</text>
          <text x="60" y="191" fill="#fff" font-size="11" font-weight="700">155℃: DOT4 ウェット沸点 (水分3.7%) 💥</text>
        </svg>
        <p class="card-desc">
          {lang === 'ja' && '吸湿したフルードは沸点が155℃まで落ち、キャリパーの過熱領域（200℃）を大幅に下回って一瞬で沸騰します！'}
          {lang === 'ca' && 'Amb un 3,7% d\'humitat la resistència cau a 155°C, molt per sota dels 200°C de la pinça en frenades fortes!'}
          {lang === 'en' && 'Moisture-degraded fluid boils at 155°C—well below caliper peak heat (180–220°C)—triggering instant vapor lock!'}
        </p>
      </div>

      <!-- Vapor Lock Physics -->
      <div class="diagram-card bad-card">
        <div class="card-status bad-status">
          <span class="status-icon">💥</span>
          <strong>
            {lang === 'ja' && 'ベーパーロックのメカニズム'}
            {lang === 'ca' && 'Mecànica del Vapor Lock'}
            {lang === 'en' && 'Vapor Lock Mechanics'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <!-- Brake Line Tube -->
          <rect x="30" y="60" width="260" height="35" rx="6" fill="#151922" stroke="#4895ef" stroke-width="2" />
          <text x="160" y="50" text-anchor="middle" fill="#a8b3cf" font-size="10">BRAKE LINE & CALIPER BORE</text>

          <!-- Normal Liquid vs Steam Bubbles -->
          <rect x="35" y="65" width="130" height="25" fill="#4895ef" opacity="0.6" />
          <text x="100" y="81" text-anchor="middle" fill="#fff" font-size="10" font-weight="700">非圧縮性液体 (油圧伝達)</text>

          <!-- Boiling Bubble Zone -->
          <rect x="175" y="65" width="110" height="25" fill="#e63946" opacity="0.4" />
          <circle cx="195" cy="77" r="7" fill="#ffd166" stroke="#e63946" stroke-width="1.5" />
          <circle cx="215" cy="74" r="5" fill="#ffd166" stroke="#e63946" stroke-width="1.5" />
          <circle cx="235" cy="80" r="8" fill="#ffd166" stroke="#e63946" stroke-width="1.5" />
          <circle cx="255" cy="73" r="6" fill="#ffd166" stroke="#e63946" stroke-width="1.5" />
          <circle cx="272" cy="78" r="4" fill="#ffd166" stroke="#e63946" stroke-width="1.5" />

          <!-- Lever force vs collapse -->
          <path d="M 40,130 L 140,130" stroke="#2a9d8f" stroke-width="4" marker-end="url(#arrowGood)" />
          <text x="90" y="120" text-anchor="middle" fill="#2a9d8f" font-size="11" font-weight="700">正常時：ピストンへ100%直結</text>

          <path d="M 180,130 Q 230,150 280,130" stroke="#e63946" stroke-width="4" stroke-dasharray="4,4" />
          <text x="235" y="165" text-anchor="middle" fill="#ff758f" font-size="11" font-weight="700">気泡が縮むだけ (レバー底づき)</text>
          <text x="235" y="180" text-anchor="middle" fill="#ff758f" font-size="9">COMPRESSIBLE VAPOR BUBBLES</text>
        </svg>
        <p class="card-desc">
          {lang === 'ja' && '気体は容易に圧縮されるため、レバーをいくら握っても気泡が縮むだけでピストンに油圧が届かず制動力がゼロになります。'}
          {lang === 'ca' && 'El vapor de gas és altament compressible: la maneta s\'enfonsa al manillar sense moure les pastilles de fre.'}
          {lang === 'en' && 'Gas vapors compress like a soft sponge: lever force is wasted squishing bubbles, delivering zero clamp force.'}
        </p>
      </div>

      <!-- Bleeding Procedure -->
      <div class="diagram-card good-card">
        <div class="card-status good-status">
          <span class="status-icon">💧</span>
          <strong>
            {lang === 'ja' && '確実なエア抜きプロトコル'}
            {lang === 'ca' && 'Protocol de Purga'}
            {lang === 'en' && 'Bleeding Cadence'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <!-- Flow steps -->
          <g transform="translate(20, 30)">
            <rect x="0" y="0" width="280" height="42" rx="6" fill="#1b202c" stroke="#2a9d8f" stroke-width="1.5" />
            <text x="20" y="26" fill="#ffb703" font-size="13" font-weight="900">①</text>
            <text x="45" y="25" fill="#f4f6fb" font-size="11" font-weight="700">マスターシリンダー頂点から開始</text>
            <text x="45" y="37" fill="#a8b3cf" font-size="9">最上部のエア溜まりを最初に追い出す</text>
          </g>
          <g transform="translate(20, 85)">
            <rect x="0" y="0" width="280" height="42" rx="6" fill="#1b202c" stroke="#2a9d8f" stroke-width="1.5" />
            <text x="20" y="26" fill="#ffb703" font-size="13" font-weight="900">②</text>
            <text x="45" y="25" fill="#f4f6fb" font-size="11" font-weight="700">キャリパー（遠い側 → 近い側）</text>
            <text x="45" y="37" fill="#a8b3cf" font-size="9">ダブルディスク車は配管が長い側から順に</text>
          </g>
          <g transform="translate(20, 140)">
            <rect x="0" y="0" width="280" height="55" rx="6" fill="#151922" stroke="#ffb703" stroke-width="1.5" />
            <text x="20" y="32" fill="#ffb703" font-size="13" font-weight="900">③</text>
            <text x="45" y="25" fill="#ffb703" font-size="11" font-weight="700">レバー操作は「ゆっくり深く保持」</text>
            <text x="45" y="40" fill="#f4f6fb" font-size="9">パカパカ速く握らない！（微細気泡化・エマルジョン防止）</text>
            <text x="45" y="51" fill="#a8b3cf" font-size="8">Slow, steady strokes prevent fluid aeration</text>
          </g>
        </svg>
        <p class="card-desc">
          {lang === 'ja' && '高所エア抜きから始め、レバーをゆっくり操作するのが鉄則。ワンウェイバルブで逆流を完全遮断！'}
          {lang === 'ca' && 'Començar sempre pel punt més alt i accionar lentament la maneta per no emulsionar el fluid.'}
          {lang === 'en' && 'Bleed top-down with disciplined, deliberate lever strokes to prevent whipping fluid into micro-foam.'}
        </p>
      </div>
    </div>
  </figure>
)}

{slug === 'circuit-maintenance-tire-pressure-hot-management-physics' && (
  <figure class="tech-diagram-figure" data-i18n={lang}>
    <div class="diagram-header">
      <span class="diagram-tag racing-font">🔧 TECHNICAL ILLUSTRATION</span>
      <h3 class="diagram-title">
        {lang === 'ja' && '【図解】ゲイ＝リュサックの法則による温間空気圧上昇とウォーマー熱浸透'}
        {lang === 'ca' && '【Esquema Tècnic】Termodinàmica de la Pressió en Calent i Escalfadors'}
        {lang === 'en' && '【Technical Diagram】Gay-Lussac\'s Pressure Physics & Tire Warmer Rim Heat Soak'}
      </h3>
      <p class="diagram-caption">
        {lang === 'ja' && '温度+10℃で約+7〜10kPa上昇！冷間と温間のギャップと、リムまで均一に温める最低45分の物理'}
        {lang === 'ca' && 'Augment de 7 a 10 kPa per cada 10°C i per què calen 45 minuts per escalfar la massa d\'alumini'}
        {lang === 'en' && 'Calculating ~7–10 kPa pressure rise per 10°C thermal jump and why alloy rims need 45 minutes to soak'}
      </p>
    </div>

    <div class="diagram-grid">
      <!-- Pressure vs Temp Graph -->
      <div class="diagram-card detail-card">
        <div class="card-status detail-status">
          <span class="status-icon">📈</span>
          <strong>
            {lang === 'ja' && 'ゲイ＝リュサックの法則グラフ'}
            {lang === 'ca' && 'Gràfica Pressió - Temperatura'}
            {lang === 'en' && 'P-T Linear Expansion'}
          </strong>
        </div>
        <svg viewBox="0 0 320 220" class="diagram-svg" aria-hidden="true">
          <!-- Graph axes -->
          <line x1="40" y1="180" x2="290" y2="180" stroke="#3a4055" stroke-width="2" />
          <line x1="40" y1="30" x2="40" y2="180" stroke="#3a4055" stroke-width="2" />
          
          <!-- Axis labels -->
          <text x="290" y="200" text-anchor="end" fill="#a8b3cf" font-size="10">温度 TEMP (℃)</text>
