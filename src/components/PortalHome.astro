---
import Header from './Header.astro';
import ArticleCard from './ArticleCard.astro';
import Footer from './Footer.astro';
import { getAllArticles } from '../data/articles';
import { UI_TEXT } from '../data/i18n';

const allArticles = getAllArticles();
const TOP_LIMIT = 12;
const articles = allArticles.slice(0, TOP_LIMIT);
const totalCount = allArticles.length;
const categories = ['all', 'kyushu', 'endurance-fun', 'maintenance', 'world', 'all-japan', 'spotlight'] as const;
---

<Header activeNav="home" />

<main>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="badge hero-badge">
          <span data-i18n="ja">{UI_TEXT.hero.badge.ja}</span>
          <span data-i18n="ca">{UI_TEXT.hero.badge.ca}</span>
          <span data-i18n="en">{UI_TEXT.hero.badge.en}</span>
        </span>

        <h1 class="hero-title">
          <span data-i18n="ja">{UI_TEXT.hero.title.ja}</span>
          <span data-i18n="ca">{UI_TEXT.hero.title.ca}</span>
          <span data-i18n="en">{UI_TEXT.hero.title.en}</span>
        </h1>

        <p class="hero-subtitle">
          <span data-i18n="ja">{UI_TEXT.hero.subtitle.ja}</span>
          <span data-i18n="ca">{UI_TEXT.hero.subtitle.ca}</span>
          <span data-i18n="en">{UI_TEXT.hero.subtitle.en}</span>
        </p>

        <div class="hero-actions">
          <a href="#articles" class="btn btn-primary">
            <span data-i18n="ja">{UI_TEXT.hero.ctaPrimary.ja}</span>
            <span data-i18n="ca">{UI_TEXT.hero.ctaPrimary.ca}</span>
            <span data-i18n="en">{UI_TEXT.hero.ctaPrimary.en}</span>
          </a>
          <a href="/schedule/" class="btn btn-secondary">
            <span data-i18n="ja">{UI_TEXT.hero.ctaSecondary.ja}</span>
            <span data-i18n="ca">{UI_TEXT.hero.ctaSecondary.ca}</span>
            <span data-i18n="en">{UI_TEXT.hero.ctaSecondary.en}</span>
          </a>
        </div>

        <div class="hero-stats">
          <div class="stat-pill">
            <strong class="racing-font">3 LANGS</strong>
            <span data-i18n="ja">日本語 · カタルーニャ語 · 英語</span>
            <span data-i18n="ca">Català · Japonès · Anglès</span>
            <span data-i18n="en">JA · Català · EN</span>
          </div>
          <div class="stat-pill">
            <strong class="racing-font">KYUSHU FOCUS</strong>
            <span data-i18n="ja">SPA直入 · オートポリス · HSR九州</span>
            <span data-i18n="ca">SPA Naoiri · Autopolis · HSR</span>
            <span data-i18n="en">SPA Naoiri · Autopolis · HSR</span>
          </div>
          <div class="stat-pill">
            <strong class="racing-font">FULL AUTO AI</strong>
            <span data-i18n="ja">情報収集〜記事・3言語翻訳まで自動化</span>
            <span data-i18n="ca">Recerca, redacció i traducció 100% IA</span>
            <span data-i18n="en">Automated AI Scouting & Translation</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-frame">
          <img
            src="/images/cats/hero-paddock.png"
            alt="Marc, Suzuka, and Naomi bipedal paddock cats in the pit lane"
            class="hero-img"
          />
          <div class="hero-caption">
            <span data-i18n="ja">📸 左から：マルク（MotoGP・SBK担当）、スズカ（全日本＆全国地方選担当）、ナオミ（サーキット整備＆耐久担当・黒雌猫）</span>
            <span data-i18n="ca">📸 D'esquerra a dreta: Marc (MotoGP/SBK), Suzuka (Nacional/Regional) i Naomi (Manteniment i Resistència)</span>
            <span data-i18n="en">📸 Left to right: Marc (MotoGP/SBK), Suzuka (All-Japan/Regional), and Naomi (Track Maintenance & Endurance)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Race Articles Section with Category Filter -->
  <section id="articles" class="articles-section">
    <div class="container">
      <div class="articles-header">
        <div>
          <div class="articles-badge-row">
            <span class="badge" style="background: rgba(42, 157, 143, 0.16); color: #4ecdc4;">
              PADDOCK DISPATCH & RACE DIGEST
            </span>
            <span class="badge count-badge racing-font">
              <span data-i18n="ja">最新 {TOP_LIMIT} 件（全 {totalCount} 件）</span>
              <span data-i18n="ca">Últimes {TOP_LIMIT} (de {totalCount})</span>
              <span data-i18n="en">Latest {TOP_LIMIT} of {totalCount}</span>
            </span>
          </div>
          <h2 class="section-heading">
            <span data-i18n="ja">🏁 最新レース開催プレビュー・結果ダイジェスト・技術解説＆整備情報</span>
            <span data-i18n="ca">🏁 Últimes Cròniques, Prèvies, Resultats i Manteniment de Circuit</span>
            <span data-i18n="en">🏁 Latest Race Previews, Results Digests, Super Saves & Track Maintenance</span>
          </h2>
          <p class="articles-subnote">
            <span data-i18n="ja">トップページでは最新12件を表示しています。過去記事は<a href="/articles/">全記事一覧・バックナンバー</a>からご覧いただけます。</span>
            <span data-i18n="ca">Mostrant les últimes 12 cròniques. Podeu consultar l'històric complet a l'<a href="/articles/">arxiu de cròniques</a>.</span>
            <span data-i18n="en">Displaying the latest 12 dispatches. Browse the <a href="/articles/">complete archive</a> for older race reports.</span>
          </p>
        </div>

        <div class="category-filters" role="tablist" aria-label="Category Filter">
          {categories.map((catKey, idx) => (
            <button
              type="button"
              class={`filter-btn ${idx === 0 ? 'active' : ''}`}
              data-filter-category={catKey}
            >
              <span data-i18n="ja">{UI_TEXT.categories[catKey].ja}</span>
              <span data-i18n="ca">{UI_TEXT.categories[catKey].ca}</span>
              <span data-i18n="en">{UI_TEXT.categories[catKey].en}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="articles-grid" id="articles-grid">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>

      <div class="articles-archive-cta">
        <a href="/articles/" class="archive-cta-card">
          <div class="cta-left">
            <span class="cta-badge racing-font">ALL ARCHIVE</span>
            <strong class="cta-title">
              <span data-i18n="ja">すべての記事・バックナンバーを見る（全{totalCount}件） →</span>
              <span data-i18n="ca">Veure totes les cròniques i l'històric ({totalCount} articles) →</span>
              <span data-i18n="en">View All Articles & Archive ({totalCount} Total) →</span>
            </strong>
            <p class="cta-desc">
              <span data-i18n="ja">MotoGP・世界SBK・全日本ロードレース・地方選・九州サーキット・ナオミの整備解説まで全記事を網羅</span>
              <span data-i18n="ca">Exploreu l'arxiu complet amb totes les cròniques, campionats de Kyushu i mecànica</span>
              <span data-i18n="en">Explore our complete chronological archive of race reports, regional series, and technical clinics</span>
            </p>
          </div>
          <span class="cta-arrow racing-font">VIEW ARCHIVE ➔</span>
        </a>
      </div>
    </div>
  </section>
</main>

<Footer />

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('[data-filter-category]');
    const articleCards = document.querySelectorAll('.article-card[data-category]');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-filter-category');
        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        articleCards.forEach((card) => {
          const cat = card.getAttribute('data-category');
          if (selected === 'all' || cat === selected) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .hero-section {
    padding: 3.5rem 0 4rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-badge {
    background: rgba(230, 57, 70, 0.16);
    color: #ff758f;
    border: 1px solid rgba(230, 57, 70, 0.35);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(1.85rem, 3.6vw, 2.85rem);
    font-weight: 900;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1.6rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
  }

  .stat-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: 0.65rem;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-pill strong {
    font-size: 0.78rem;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
  }

  .stat-pill span {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .hero-frame {
    background: var(--bg-card);
    border: 2px solid rgba(255, 183, 3, 0.35);
    border-radius: 1.15rem;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55);
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .hero-caption {
    padding: 0.75rem 1rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.45);
    border-top: 1px solid var(--border-subtle);
  }

  .articles-section {
    padding: 4rem 0 2rem;
  }

  .articles-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .section-heading {
    font-size: clamp(1.45rem, 2.8vw, 2rem);
    font-weight: 900;
    margin-top: 0.5rem;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .filter-btn.active {
    background: var(--accent-gold);
    color: #0d0f14;
    border-color: var(--accent-gold);
  }

  .articles-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .count-badge {
    background: rgba(255, 183, 3, 0.14);
    color: var(--accent-gold);
    border: 1px solid rgba(255, 183, 3, 0.3);
    font-size: 0.76rem;
  }

  .articles-subnote {
    margin-top: 0.45rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .articles-subnote a {
    color: var(--accent-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .articles-subnote a:hover {
    color: #fff;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.6rem;
  }

  .articles-archive-cta {
    margin-top: 2.75rem;
  }

  .archive-cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, rgba(27, 32, 44, 0.95), rgba(21, 25, 34, 0.95));
    border: 1px solid rgba(255, 183, 3, 0.35);
    border-radius: 1rem;
    transition: all 0.25s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .archive-cta-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-gold);
    box-shadow: 0 12px 30px rgba(255, 183, 3, 0.15);
    background: linear-gradient(135deg, rgba(34, 40, 56, 0.98), rgba(25, 30, 42, 0.98));
  }

  .cta-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cta-badge {
    align-self: flex-start;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    background: rgba(255, 183, 3, 0.12);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .cta-title {
    font-size: 1.15rem;
    color: #fff;
  }

  .cta-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .cta-arrow {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-gold);
    padding: 0.65rem 1.1rem;
    background: rgba(255, 183, 3, 0.12);
    border: 1px solid rgba(255, 183, 3, 0.3);
    border-radius: 8px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .archive-cta-card:hover .cta-arrow {
    background: var(--accent-gold);
    color: #0d0f14;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .archive-cta-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem 1.4rem;
    }

    .cta-arrow {
      align-self: stretch;
      text-align: center;
    }
  }
</style>
