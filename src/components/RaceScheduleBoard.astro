---
import schedulesData from '../data/schedules.json';
import sourcesConfig from '../../scripts/sources_config.json';
import { getAllArticles } from '../data/articles';

const events = schedulesData.events;
const sources = sourcesConfig.sources;
const allArticles = getAllArticles();
const articleMap = new Map(allArticles.map((art) => [art.id, art]));

const CATEGORY_META: Record<
  string,
  {
    icon: string;
    color: string;
    label: { ja: string; ca: string; en: string };
  }
> = {
  world: {
    icon: '🌍',
    color: '#e63946',
    label: {
      ja: '世界選手権 (MotoGP / WorldSBK)',
      ca: 'Mundial (MotoGP / WorldSBK)',
      en: 'World Championship (MotoGP / WorldSBK)',
    },
  },
  'all-japan': {
    icon: '🗾',
    color: '#2a9d8f',
    label: {
      ja: 'MFJ全日本・全国地方選手権',
      ca: 'Campionat del Japó MFJ i Regionals',
      en: 'MFJ All-Japan & Regional Championships',
    },
  },
  kyushu: {
    icon: '🔥',
    color: '#ffb703',
    label: {
      ja: '九州サーキット (オートポリス / SPA直入 / HSR九州)',
      ca: 'Circuits de Kyushu (Autopolis / SPA Naoiri / HSR)',
      en: 'Kyushu Circuits (Autopolis / SPA Naoiri / HSR)',
    },
  },
  'endurance-fun': {
    icon: '🏁',
    color: '#c77dff',
    label: {
      ja: '草耐久・レン耐 (お題付耐久 / Let\'s レン耐)',
      ca: 'Resistència Grassroots i Rentai',
      en: 'Grassroots Endurance & Rentai',
    },
  },
};

const enrichedEvents = events.map((ev) => {
  const resultArticleId = ev.publicationState?.resultArticleId || null;
  const linkedArticle = resultArticleId ? articleMap.get(resultArticleId) : undefined;
  const catMeta = CATEGORY_META[ev.category] || CATEGORY_META.kyushu;
  return {
    ...ev,
    catIcon: catMeta.icon,
    catColor: catMeta.color,
    catLabel: catMeta.label,
    articleSlug: linkedArticle?.slug || null,
  };
});

interface CalendarDayCell {
  day: number | null;
  dateStr: string | null;
  dayOfWeek: number; // 0 = Mon ... 6 = Sun
  events: typeof enrichedEvents;
}

interface CalendarMonth {
  key: string;
  year: number;
  month: number; // 1-12
  label: { ja: string; ca: string; en: string };
  cells: CalendarDayCell[];
  eventCount: number;
}

const CA_MONTHS = ['Gener', 'Febrer', 'Març', 'Abril', 'Maig', 'Juny', 'Juliol', 'Agost', 'Setembre', 'Octubre', 'Novembre', 'Desembre'];
const EN_MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const MONTH_LABELS: Record<number, { ja: string; ca: string; en: string }> = Object.fromEntries(
  Array.from({ length: 12 }, (_, i) => [
    i + 1,
    { ja: `2026年 ${i + 1}月`, ca: `${CA_MONTHS[i]} 2026`, en: `${EN_MONTHS[i]} 2026` },
  ])
);

function buildCalendarMonths(year: number, months: number[]): CalendarMonth[] {
  return months.map((month) => {
    const daysInMonth = new Date(year, month, 0).getDate();
    // JS getDay(): 0 = Sun, 1 = Mon ... 6 = Sat. Convert to Monday-first: 0 = Mon ... 6 = Sun
    const firstJsDay = new Date(year, month - 1, 1).getDay();
    const leadingEmpty = (firstJsDay + 6) % 7;

    const cells: CalendarDayCell[] = [];
    for (let i = 0; i < leadingEmpty; i++) {
      cells.push({
        day: null,
        dateStr: null,
        dayOfWeek: i,
        events: [],
      });
    }

    const monthPrefix = `${year}-${String(month).padStart(2, '0')}`;
    const monthEventsSet = new Set<string>();

    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr = `${monthPrefix}-${String(d).padStart(2, '0')}`;
      const dayOfWeek = (leadingEmpty + d - 1) % 7;
      const dayEvents = enrichedEvents.filter(
        (ev) => ev.startDate <= dateStr && dateStr <= ev.endDate
      );
      dayEvents.forEach((ev) => monthEventsSet.add(ev.id));

      cells.push({
        day: d,
        dateStr,
        dayOfWeek,
        events: dayEvents,
      });
    }

    while (cells.length % 7 !== 0) {
      cells.push({
        day: null,
        dateStr: null,
        dayOfWeek: cells.length % 7,
        events: [],
      });
    }

    return {
      key: monthPrefix,
      year,
      month,
      label: MONTH_LABELS[month] || {
        ja: `${year}年 ${month}月`,
        ca: `${month}/${year}`,
        en: `${year}-${month}`,
      },
      cells,
      eventCount: monthEventsSet.size,
    };
  });
}

// Derive the month range from schedule data (first event month .. last event month)
const allMonthNums = enrichedEvents.flatMap((ev) => [
  Number(ev.startDate.slice(5, 7)),
  Number(ev.endDate.slice(5, 7)),
]);
const firstMonth = Math.min(...allMonthNums);
const lastMonth = Math.max(...allMonthNums);
const calendarMonths = buildCalendarMonths(
  2026,
  Array.from({ length: lastMonth - firstMonth + 1 }, (_, i) => firstMonth + i)
);
const defaultMonthKey = calendarMonths[calendarMonths.length - 1]?.key || 'all';
const allTabLabel = {
  ja: `すべて表示 (${firstMonth}月〜${lastMonth}月)`,
  ca: `Tots (${CA_MONTHS[firstMonth - 1].slice(0, 3)}–${CA_MONTHS[lastMonth - 1].slice(0, 3)})`,
  en: `All Months (${EN_MONTHS[firstMonth - 1].slice(0, 3)}–${EN_MONTHS[lastMonth - 1].slice(0, 3)})`,
};
const weekdays = [
  { ja: '月', ca: 'DL', en: 'MON', isWeekend: false },
  { ja: '火', ca: 'DT', en: 'TUE', isWeekend: false },
  { ja: '水', ca: 'DC', en: 'WED', isWeekend: false },
  { ja: '木', ca: 'DJ', en: 'THU', isWeekend: false },
  { ja: '金', ca: 'DV', en: 'FRI', isWeekend: false },
  { ja: '土', ca: 'DS', en: 'SAT', isWeekend: true },
  { ja: '日', ca: 'DG', en: 'SUN', isWeekend: true },
];
---

<section id="schedule-board" class="schedule-section">
  <div class="container">
    <div class="schedule-header">
      <div class="schedule-badges">
        <span class="badge" style="background: rgba(42, 157, 143, 0.18); color: #4ecdc4; border: 1px solid rgba(42, 157, 143, 0.4);">
          📡 AUTO-COLLECTED FROM OFFICIAL CALENDARS & SNS
        </span>
        <span class="badge" style="background: rgba(255, 255, 255, 0.06); color: var(--text-secondary);">
          MotoGP · WorldSBK · MFJ全日本＆全国地方選手権（北海道〜九州）· オートポリス · SPA直入 · HSR九州
        </span>
      </div>

      <h2 class="schedule-title">
        <span data-i18n="ja">🗓️ 公式レース開催スケジュール＆全国サーキット・SNS自動収集ボード</span>
        <span data-i18n="ca">🗓️ Calendari Oficial de Curses i Monitorització de Circuits i Xarxes Socials</span>
        <span data-i18n="en">🗓️ Official Race Calendar & Nationwide Circuit / SNS Auto-Monitor Board</span>
      </h2>

      <p class="schedule-subtitle">
        <span data-i18n="ja">
          MotoGP公式サイト、MFJ公式サイト（全日本ロードレースおよび北海道・東北SUGO・関東もてぎ/筑波/富士・鈴鹿・岡山国際・九州の全国地方選手権）、九州3大サーキット（オートポリス・SPA直入・HSR九州）の公式カレンダーおよび公式SNSアカウントから週次で年間スケジュールを自動同期しています。
        </span>
        <span data-i18n="ca">
          Sincronitzat setmanalment dels webs oficials i xarxes socials de MotoGP, MFJ (Campionat del Japó i tots els campionats regionals de Hokkaido, SUGO, Motegi, Tsukuba, Fuji, Suzuka, Okayama i Kyushu), Autopolis, SPA Naoiri i HSR Kyushu.
        </span>
        <span data-i18n="en">
          Synced weekly from the official websites and SNS accounts of MotoGP, MFJ (All-Japan Road Race & all regional championships across Hokkaido, SUGO, Motegi, Tsukuba, Fuji, Suzuka, Okayama, and Kyushu), Autopolis, SPA Naoiri, and HSR Kyushu.
        </span>
      </p>
    </div>

    <!-- ==========================================
         INTERACTIVE RACE CALENDAR WITH ICON TOOLTIPS
         ========================================== -->
    <div class="calendar-board-card">
      <div class="calendar-board-top">
        <div class="calendar-board-heading">
          <h3 class="calendar-board-title">
            <span data-i18n="ja">📅 カテゴリー別レース開催カレンダー（アイコンをホバー／タップで詳細ティップス表示）</span>
            <span data-i18n="ca">📅 Calendari per Categories (Passa el cursor o toca les icones per veure els detalls)</span>
            <span data-i18n="en">📅 Category Race Calendar (Hover or Tap Icons for Event Tooltip)</span>
          </h3>
          <p class="calendar-board-hint">
            <span data-i18n="ja">💡 カレンダー内の各カテゴリーアイコン（🌍 🗾 🔥 🏁）にマウスを重ねるかタップすると、大会名・開催サーキット・クラス・結果記事へのリンクが表示されます。</span>
            <span data-i18n="ca">💡 Passa el ratolí per sobre o toca qualsevol icona (🌍 🗾 🔥 🏁) per obrir la fitxa amb el nom de la cursa, el circuit i l'enllaç a la crònica.</span>
            <span data-i18n="en">💡 Hover over or tap any category icon (🌍 🗾 🔥 🏁) in the calendar to view the race name, circuit, classes, and race report link.</span>
          </p>
        </div>

        <div class="calendar-month-tabs" role="tablist" aria-label="Calendar Month Filter">
          <button type="button" class="cal-month-tab" data-month-filter="all">
            <span data-i18n="ja">{allTabLabel.ja}</span>
            <span data-i18n="ca">{allTabLabel.ca}</span>
            <span data-i18n="en">{allTabLabel.en}</span>
          </button>
          {calendarMonths.map((m) => (
            <button type="button" class={`cal-month-tab ${m.key === defaultMonthKey ? 'active' : ''}`} data-month-filter={m.key}>
              <span data-i18n="ja">{m.label.ja}</span>
              <span data-i18n="ca">{m.label.ca}</span>
              <span data-i18n="en">{m.label.en}</span>
              <span class="cal-tab-count">{m.eventCount}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Category Icon Legend -->
      <div class="calendar-legend">
        {Object.entries(CATEGORY_META).map(([catKey, meta]) => (
          <div class={`legend-item cat-badge-${catKey}`}>
            <span class="legend-icon">{meta.icon}</span>
            <span class="legend-text">
              <span data-i18n="ja">{meta.label.ja}</span>
              <span data-i18n="ca">{meta.label.ca}</span>
              <span data-i18n="en">{meta.label.en}</span>
            </span>
          </div>
        ))}
      </div>

      <!-- Monthly Calendars Grid -->
      <div class="calendar-months-grid" id="calendar-months-grid">
        {calendarMonths.map((m) => (
          <div class="calendar-month-card" data-month-card={m.key}>
            <div class="cal-month-header">
              <h4 class="cal-month-title">
                <span data-i18n="ja">{m.label.ja}</span>
                <span data-i18n="ca">{m.label.ca}</span>
                <span data-i18n="en">{m.label.en}</span>
              </h4>
              <span class="cal-month-meta">
                {m.eventCount} <span data-i18n="ja">大会</span><span data-i18n="ca">curses</span><span data-i18n="en">events</span>
              </span>
            </div>

            <div class="cal-weekdays-row">
              {weekdays.map((w, idx) => (
                <div class={`cal-weekday ${w.isWeekend ? (idx === 5 ? 'sat' : 'sun') : ''}`}>
                  <span data-i18n="ja">{w.ja}</span>
                  <span data-i18n="ca">{w.ca}</span>
                  <span data-i18n="en">{w.en}</span>
                </div>
              ))}
            </div>

            <div class="cal-days-grid">
              {m.cells.map((cell) => {
                const hasEvents = cell.events.length > 0;
                const isSat = cell.dayOfWeek === 5;
                const isSun = cell.dayOfWeek === 6;
                return (
                  <div
                    class={`cal-day-cell ${cell.day === null ? 'empty' : ''} ${hasEvents ? 'has-events' : ''} ${isSat ? 'is-sat' : ''} ${isSun ? 'is-sun' : ''}`}
                    data-date={cell.dateStr || undefined}
                  >
                    {cell.day !== null && (
                      <>
                        <span class="cal-day-num">{cell.day}</span>
                        {hasEvents && (
                          <div class="cal-day-icons">
                            {cell.events.map((ev) => (
                              <button
                                type="button"
                                class={`cal-event-icon-btn cat-btn-${ev.category}`}
                                data-event-id={ev.id}
                                data-date={cell.dateStr}
                                aria-label={`${ev.eventName.ja} (${cell.dateStr})`}
                              >
                                <span class="cal-icon-emoji">{ev.catIcon}</span>
                              </button>
                            ))}
                          </div>
                        )}
                      </>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- Hidden Event Tooltip Templates & Floating Tooltip Container -->
      <div id="calendar-tooltip-templates" hidden>
        {enrichedEvents.map((ev) => (
          <div data-tooltip-template={ev.id}>
            <div class={`cal-tip-inner cat-tip-${ev.category}`}>
              <div class="cal-tip-header">
                <span class={`cal-tip-cat-pill cat-pill-${ev.category}`}>
                  {ev.catIcon}{' '}
                  <span data-i18n="ja">{ev.catLabel.ja}</span>
                  <span data-i18n="ca">{ev.catLabel.ca}</span>
                  <span data-i18n="en">{ev.catLabel.en}</span>
                </span>
                <button type="button" class="cal-tip-close" aria-label="Close tooltip">✕</button>
              </div>

              <div class="cal-tip-series">{ev.series}</div>

              <h5 class="cal-tip-title">
                <span data-i18n="ja">{ev.eventName.ja}</span>
                <span data-i18n="ca">{ev.eventName.ca}</span>
                <span data-i18n="en">{ev.eventName.en}</span>
              </h5>

              <div class="cal-tip-meta">
                <div class="cal-tip-meta-item">
                  <strong>📍 </strong>
                  <span data-i18n="ja">{ev.circuit.ja}</span>
                  <span data-i18n="ca">{ev.circuit.ca}</span>
                  <span data-i18n="en">{ev.circuit.en}</span>
                </div>
                <div class="cal-tip-meta-item">
                  <strong>🗓️ </strong>
                  <span data-i18n="ja">{ev.scheduleWindow.ja}</span>
                  <span data-i18n="ca">{ev.scheduleWindow.ca}</span>
                  <span data-i18n="en">{ev.scheduleWindow.en}</span>
                </div>
                <div class="cal-tip-meta-item">
                  <strong>🏍️ </strong>
                  <span>{ev.classes}</span>
                </div>
              </div>

              <div class="cal-tip-actions">
                {ev.articleSlug && (
                  <a href={`/articles/${ev.articleSlug}/`} class="cal-tip-btn primary">
                    📰 <span data-i18n="ja">レース結果記事を読む</span>
                    <span data-i18n="ca">Llegir la crònica</span>
                    <span data-i18n="en">Read Race Report</span>
                  </a>
                )}
                <a href={`#sched-card-${ev.id}`} class="cal-tip-btn secondary" data-jump-card={`sched-card-${ev.id}`}>
                  📋 <span data-i18n="ja">スケジュール詳細へ</span>
                  <span data-i18n="ca">Fitxa de la cursa</span>
                  <span data-i18n="en">Jump to Card</span>
                </a>
                <a href={ev.officialWebUrl} target="_blank" rel="noopener noreferrer" class="cal-tip-btn ghost">
                  🌐 <span data-i18n="ja">公式情報</span>
                  <span data-i18n="ca">Web Oficial</span>
                  <span data-i18n="en">Official Web</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div id="calendar-floating-tooltip" class="calendar-floating-tooltip" role="dialog" aria-hidden="true"></div>
    </div>

    <!-- ==========================================
         DETAILED SCHEDULE CARDS LIST
         ========================================== -->
    <div class="schedule-list-heading">
      <h3 class="schedule-list-title">
        <span data-i18n="ja">📋 大会別スケジュール・公式リンク一覧</span>
        <span data-i18n="ca">📋 Llista Detallada de Curses i Enllaços Oficials</span>
        <span data-i18n="en">📋 Detailed Race Schedule & Official Links</span>
      </h3>
    </div>

    <div class="schedule-grid">
      {enrichedEvents.map((ev) => (
        <div
          id={`sched-card-${ev.id}`}
          class={`schedule-card cat-${ev.category}`}
          data-event-month={ev.startDate.slice(0, 7)}
        >
          <div class="sched-top">
            <span class="sched-series">
              {ev.catIcon} {ev.series}
            </span>
            <span class="sched-verified">✅ {ev.verifiedSource}</span>
          </div>

          <h3 class="sched-event">
            <span data-i18n="ja">{ev.eventName.ja}</span>
            <span data-i18n="ca">{ev.eventName.ca}</span>
            <span data-i18n="en">{ev.eventName.en}</span>
          </h3>

          <div class="sched-meta-list">
            <div class="sched-meta-row">
              <strong>📍 </strong>
              <span data-i18n="ja">{ev.circuit.ja}</span>
              <span data-i18n="ca">{ev.circuit.ca}</span>
              <span data-i18n="en">{ev.circuit.en}</span>
            </div>
            <div class="sched-meta-row">
              <strong>🗓️ </strong>
              <span data-i18n="ja">{ev.scheduleWindow.ja}</span>
              <span data-i18n="ca">{ev.scheduleWindow.ca}</span>
              <span data-i18n="en">{ev.scheduleWindow.en}</span>
            </div>
            <div class="sched-meta-row">
              <strong>🏍️ Classes: </strong>
              <span>{ev.classes}</span>
            </div>
          </div>

          <div class="sched-links">
            {ev.articleSlug && (
              <a href={`/articles/${ev.articleSlug}/`} class="source-pill article-pill">
                📰 <span data-i18n="ja">レース結果記事</span><span data-i18n="ca">Crònica de la Cursa</span><span data-i18n="en">Race Report</span>
              </a>
            )}
            <a href={ev.officialWebUrl} target="_blank" rel="noopener noreferrer" class="source-pill web-pill">
              🌐 <span data-i18n="ja">公式カレンダー</span><span data-i18n="ca">Calendari Oficial</span><span data-i18n="en">Official Calendar</span>
            </a>
            <a href={ev.circuitWebUrl} target="_blank" rel="noopener noreferrer" class="source-pill circuit-pill">
              🏁 <span data-i18n="ja">サーキット/連盟公式</span><span data-i18n="ca">Web Circuit/MFJ</span><span data-i18n="en">Circuit/MFJ Web</span>
            </a>
            <a href={ev.snsUrl} target="_blank" rel="noopener noreferrer" class="source-pill sns-pill">
              📱 {ev.snsHandle}
            </a>
          </div>
        </div>
      ))}
    </div>

    <details class="crawler-registry-details">
      <summary class="registry-summary">
        <span data-i18n="ja">🔍 自動収集対象の公式サイト・全国サーキット・公式SNS一覧（全 {sources.length} 系統）を表示</span>
        <span data-i18n="ca">🔍 Veure totes les fonts oficials i comptes de xarxes socials monitoritzats ({sources.length} sistemes)</span>
        <span data-i18n="en">🔍 View All Monitored Official Websites, Nationwide Circuits & SNS Accounts ({sources.length} feeds)</span>
      </summary>
      <div class="registry-table-wrap">
        <table class="registry-table">
          <thead>
            <tr>
              <th>REGION / AREA</th>
              <th>OFFICIAL ORGANIZATION / CIRCUIT</th>
              <th>CALENDAR URLS</th>
              <th>OFFICIAL SNS ACCOUNTS</th>
            </tr>
          </thead>
          <tbody>
            {sources.map((src) => (
              <tr>
                <td class="reg-region racing-font">{src.region}</td>
                <td>
                  <span data-i18n="ja">{src.name.ja}</span>
                  <span data-i18n="ca">{src.name.ca}</span>
                  <span data-i18n="en">{src.name.en}</span>
                </td>
                <td>
                  <div class="url-list">
                    {src.calendarUrls.map((u) => (
                      <a href={u} target="_blank" rel="noopener noreferrer" class="reg-link">{u}</a>
                    ))}
                  </div>
                </td>
                <td>
                  <div class="sns-list">
                    {src.sns.map((s) => (
                      <a href={s.url} target="_blank" rel="noopener noreferrer" class="reg-sns-badge">
                        {s.platform}: {s.handle}
                      </a>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </div>
</section>

<script is:inline>
  (function () {
    const tooltipEl = document.getElementById('calendar-floating-tooltip');
    const templatesContainer = document.getElementById('calendar-tooltip-templates');
    if (!tooltipEl || !templatesContainer) return;

    let activeBtn = null;
    let pinnedByClick = false;
    let closeTimer = null;

    function clearCloseTimer() {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
    }

    function scheduleClose(delay) {
      clearCloseTimer();
      closeTimer = setTimeout(() => {
        if (!pinnedByClick) {
          hideTooltip();
        }
      }, delay || 160);
    }

    function positionTooltip(triggerBtn) {
      if (!triggerBtn || !tooltipEl.classList.contains('is-open')) return;
      const rect = triggerBtn.getBoundingClientRect();
      const tipRect = tooltipEl.getBoundingClientRect();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const margin = 12;

      // Horizontal centering relative to icon, clamped within viewport margins
      let left = rect.left + rect.width / 2 - tipRect.width / 2;
      if (left < margin) left = margin;
      if (left + tipRect.width > vw - margin) {
        left = Math.max(margin, vw - tipRect.width - margin);
      }

      // Prefer placing below the icon unless near the bottom of the screen
      let top = rect.bottom + 10;
      if (top + tipRect.height > vh - margin && rect.top - tipRect.height - 10 > margin) {
        top = rect.top - tipRect.height - 10;
      }

      tooltipEl.style.left = `${Math.round(left)}px`;
      tooltipEl.style.top = `${Math.round(top)}px`;
    }

    function showTooltipForButton(btn, isPinned) {
      clearCloseTimer();
      const eventId = btn.getAttribute('data-event-id');
      if (!eventId) return;

      const tpl = templatesContainer.querySelector(`[data-tooltip-template="${eventId}"]`);
      if (!tpl) return;

      if (activeBtn && activeBtn !== btn) {
        activeBtn.classList.remove('is-active');
      }

      activeBtn = btn;
      activeBtn.classList.add('is-active');
      if (isPinned) {
        pinnedByClick = true;
      }

      tooltipEl.innerHTML = tpl.innerHTML;
      tooltipEl.classList.add('is-open');
      tooltipEl.setAttribute('aria-hidden', 'false');

      // Wire close button inside tooltip
      const closeBtn = tooltipEl.querySelector('.cal-tip-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          hideTooltip();
        });
      }

      // Wire smooth scroll + highlight for "Jump to Card" button
      const jumpBtn = tooltipEl.querySelector('[data-jump-card]');
      if (jumpBtn) {
        jumpBtn.addEventListener('click', () => {
          const targetId = jumpBtn.getAttribute('data-jump-card');
          const targetCard = targetId ? document.getElementById(targetId) : null;
          hideTooltip();
          if (targetCard) {
            targetCard.classList.remove('highlight-pulse');
            void targetCard.offsetWidth;
            targetCard.classList.add('highlight-pulse');
          }
        });
      }

      requestAnimationFrame(() => {
        positionTooltip(btn);
      });
    }

    function hideTooltip() {
      clearCloseTimer();
      pinnedByClick = false;
      if (activeBtn) {
        activeBtn.classList.remove('is-active');
        activeBtn = null;
      }
      tooltipEl.classList.remove('is-open');
      tooltipEl.setAttribute('aria-hidden', 'true');
    }

    // Bind icon buttons for both hover (desktop) and tap/click (mobile & desktop)
    const iconBtns = document.querySelectorAll('.cal-event-icon-btn');
    iconBtns.forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches && !pinnedByClick) {
          showTooltipForButton(btn, false);
        }
      });

      btn.addEventListener('mouseleave', () => {
        if (window.matchMedia('(hover: hover)').matches && !pinnedByClick) {
          scheduleClose(180);
        }
      });

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (activeBtn === btn && pinnedByClick && tooltipEl.classList.contains('is-open')) {
          hideTooltip();
        } else {
          showTooltipForButton(btn, true);
        }
      });
    });

    // Keep tooltip open when hovering inside the tooltip itself
    tooltipEl.addEventListener('mouseenter', () => {
      clearCloseTimer();
    });

    tooltipEl.addEventListener('mouseleave', () => {
      if (!pinnedByClick) {
        scheduleClose(160);
      }
    });

    // Dismiss on outside click or Escape key
    document.addEventListener('click', (e) => {
      if (!tooltipEl.classList.contains('is-open')) return;
      if (tooltipEl.contains(e.target)) return;
      if (activeBtn && activeBtn.contains(e.target)) return;
      hideTooltip();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && tooltipEl.classList.contains('is-open')) {
        hideTooltip();
      }
    });

    window.addEventListener(
      'scroll',
      () => {
        if (activeBtn && tooltipEl.classList.contains('is-open')) {
          positionTooltip(activeBtn);
        }
      },
      { passive: true }
    );

    window.addEventListener('resize', () => {
      if (activeBtn && tooltipEl.classList.contains('is-open')) {
        positionTooltip(activeBtn);
      }
    });

    // Month filter tabs
    const monthTabs = document.querySelectorAll('.cal-month-tab');
    const monthCards = document.querySelectorAll('[data-month-card]');
    const scheduleCards = document.querySelectorAll('[data-event-month]');
    const calendarGrid = document.getElementById('calendar-months-grid');

    function applyMonthFilter(selected) {
      monthTabs.forEach((t) => t.classList.toggle('active', t.getAttribute('data-month-filter') === selected));
      if (calendarGrid) {
        calendarGrid.classList.toggle('single-month-mode', selected !== 'all');
      }
      monthCards.forEach((card) => {
        const show = selected === 'all' || card.getAttribute('data-month-card') === selected;
        card.style.display = show ? '' : 'none';
      });
      scheduleCards.forEach((sc) => {
        const show = selected === 'all' || sc.getAttribute('data-event-month') === selected;
        sc.style.display = show ? '' : 'none';
      });
    }

    monthTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        hideTooltip();
        applyMonthFilter(tab.getAttribute('data-month-filter') || 'all');
      });
    });

    const initialTab = document.querySelector('.cal-month-tab.active');
    applyMonthFilter(initialTab ? initialTab.getAttribute('data-month-filter') || 'all' : 'all');
  })();
</script>

