---
import type { SnsCiteItem } from '../data/articles';
import type { Lang } from '../data/i18n';

interface Props {
  citations?: SnsCiteItem[];
  lang: Lang;
}

const { citations = [], lang } = Astro.props;

const sectionTitle: Record<Lang, string> = {
  ja: '📱 公式SNSポスト（写真・動画）＆ 猫編集部ディテール解説',
  ca: '📱 Publicacions Oficials (Fotos i Vídeo) · Anàlisi en Detall',
  en: '📱 Official Social Media Posts (Photos & Video) · Paddock Breakdown'
};

const sectionSubtitle: Record<Lang, string> = {
  ja: '※写真・画像の無断転載防止のため、各レース主催者・サーキット・チームの公式SNS投稿（写真・映像）を正式に引用・埋め込み表示しています。',
  ca: '*Per respectar els drets d\'imatge i evitar l\'ús no autoritzat de fotos, incrustem directament les publicacions oficials amb fotos i vídeos dels organitzadors i circuits.',
  en: '*To prevent unauthorized photo usage and respect copyright, we directly embed official social media posts featuring genuine race photos and videos from organizers and circuits.'
};

const commentaryLabel: Record<Lang, string> = {
  ja: '🐾 猫編集部のポスト解説',
  ca: '🐾 Anàlisi de la publicació',
  en: '🐾 Paddock Notes on this Post'
};

const quotedLabel: Record<Lang, string> = {
  ja: '💬 引用・公式発表ハイライト',
  ca: '💬 Text citat / Comunicat oficial',
  en: '💬 Quoted Post / Official Dispatch'
};

const viewActionLabels: Record<SnsCiteItem['platform'], Record<Lang, string>> = {
  X: {
    ja: '𝕏 で元ポスト・写真を見る ↗',
    ca: 'Veure publicació i fotos a 𝕏 ↗',
    en: 'View Original Post & Photos on 𝕏 ↗'
  },
  YouTube: {
    ja: 'YouTube公式でフル映像を見る ↗',
    ca: 'Veure vídeo complet a YouTube ↗',
    en: 'Watch Full Video on YouTube ↗'
  },
  OfficialWeb: {
    ja: '公式サイトで公式リザルト・写真を見る ↗',
    ca: 'Consultar resultats i fotos a la web oficial ↗',
    en: 'Check Official Results & Gallery ↗'
  },
  Facebook: {
    ja: 'Facebook公式で写真アルバムを見る ↗',
    ca: 'Veure àlbum de fotos a Facebook ↗',
    en: 'View Photo Album on Facebook ↗'
  },
  Instagram: {
    ja: 'Instagram公式で写真を見る ↗',
    ca: 'Veure fotos a Instagram ↗',
    en: 'View Photos on Instagram ↗'
  }
};

function getPlatformBadge(platform: SnsCiteItem['platform']) {
  switch (platform) {
    case 'X':
      return { icon: '𝕏', label: 'X (Twitter)', color: '#1d9bf0', bg: 'rgba(29, 155, 240, 0.12)', border: 'rgba(29, 155, 240, 0.35)' };
    case 'YouTube':
      return { icon: '▶️', label: 'YouTube Video', color: '#ff4d4d', bg: 'rgba(255, 77, 77, 0.12)', border: 'rgba(255, 77, 77, 0.35)' };
    case 'OfficialWeb':
      return { icon: '🌐', label: 'Official Web', color: '#00c49f', bg: 'rgba(0, 196, 159, 0.12)', border: 'rgba(0, 196, 159, 0.35)' };
    case 'Facebook':
      return { icon: '📘', label: 'Facebook Post', color: '#1877f2', bg: 'rgba(24, 119, 242, 0.12)', border: 'rgba(24, 119, 242, 0.35)' };
    case 'Instagram':
      return { icon: '📸', label: 'Instagram Photo', color: '#e1306c', bg: 'rgba(225, 48, 108, 0.12)', border: 'rgba(225, 48, 108, 0.35)' };
    default:
      return { icon: '🏁', label: 'Official Source', color: '#ffb703', bg: 'rgba(255, 183, 3, 0.12)', border: 'rgba(255, 183, 3, 0.35)' };
  }
}

function getXStatusUrl(url?: string): string | null {
  if (!url) return null;
  const m = url.match(/^https?:\/\/(?:www\.)?(?:twitter\.com|x\.com)\/([^/]+)\/status\/(\d+)/i);
  if (!m) return null;
  return `https://twitter.com/${m[1]}/status/${m[2]}`;
}

function getInstagramEmbedUrl(url?: string): string | null {
  if (!url) return null;
  const postMatch = url.match(/instagram\.com\/(?:p|reel)\/([A-Za-z0-9_-]+)/i);
  if (postMatch) {
    return `https://www.instagram.com/p/${postMatch[1]}/embed/captioned/`;
  }
  return null;
}

function getYouTubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  const watchMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/i);
  if (watchMatch) {
    return `https://www.youtube-nocookie.com/embed/${watchMatch[1]}`;
  }
  return null;
}
---

{citations && citations.length > 0 && (
  <section class="sns-citations-section">
    <div class="sns-section-header">
      <div class="header-main">
        <h3 class="sns-section-title">{sectionTitle[lang]}</h3>
        <p class="sns-section-subtitle">{sectionSubtitle[lang]}</p>
      </div>
    </div>

    <div class="sns-cards-grid">
      {citations.map((item) => {
        const badge = getPlatformBadge(item.platform);
        const rawTargetUrl = item.postUrl || item.url;
        const xStatusUrl = getXStatusUrl(item.postUrl) || getXStatusUrl(item.url);
        const igEmbedUrl = getInstagramEmbedUrl(item.postUrl) || getInstagramEmbedUrl(item.url);
        const ytEmbedUrl = getYouTubeEmbedUrl(item.postUrl) || getYouTubeEmbedUrl(item.url);
        const hasRichMedia = !!(xStatusUrl || igEmbedUrl || ytEmbedUrl);
        const actionLabel = (viewActionLabels[item.platform] && viewActionLabels[item.platform][lang]) || '元ポストを開く ↗';

        return (
          <div class="sns-cite-card">
            <div class="sns-card-top">
              <div class="sns-author-meta">
                <span class="sns-avatar-icon" style={`background: ${badge.bg}; color: ${badge.color}; border-color: ${badge.border};`}>
                  {badge.icon}
                </span>
                <div>
                  <div class="sns-account-name">{item.accountName}</div>
                  <a href={rawTargetUrl} target="_blank" rel="noopener noreferrer" class="sns-handle racing-font">
                    {item.handle}
                  </a>
                </div>
              </div>

              <div class="sns-top-right">
                <div class="sns-platform-tag" style={`background: ${badge.bg}; color: ${badge.color}; border: 1px solid ${badge.border};`}>
                  <span>{badge.icon}</span>
                  <span>{badge.label}</span>
                </div>
              </div>
            </div>

            {/* Direct Social Post / Video / Photo Embed */}
            {hasRichMedia && (
              <div class="sns-embed-stage">
                {xStatusUrl ? (
                  <div class="sns-x-tweet-embed">
                    <blockquote class="twitter-tweet" data-theme="dark" data-lang={lang} data-dnt="true" data-align="center">
                      <p lang={lang} dir="ltr">{item.quotedPostText?.[lang] || ''}</p>
                      &mdash; {item.accountName} ({item.handle}){' '}
                      <a href={xStatusUrl}>{item.publishedDate || 'Official Post'}</a>
                    </blockquote>
                  </div>
                ) : igEmbedUrl ? (
                  <div class="sns-ig-embed">
                    <iframe
                      src={igEmbedUrl}
                      class="ig-embed-iframe"
                      frameborder="0"
                      scrolling="no"
                      allowtransparency="true"
                      loading="lazy"
                      title={`${item.accountName} Instagram Photo Post`}
                    ></iframe>
                  </div>
                ) : ytEmbedUrl ? (
                  <div class="sns-yt-embed">
                    <iframe
                      src={ytEmbedUrl}
                      class="yt-embed-iframe"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                      title={`${item.accountName} YouTube Video`}
                    ></iframe>
                  </div>
                ) : null}
              </div>
            )}

            {/* Quoted highlight text box (shows below media or as main content when media is not a single embeddable post) */}
            {item.quotedPostText?.[lang] && !xStatusUrl && (
              <div class="sns-quoted-box">
                <div class="quoted-label">{quotedLabel[lang]}</div>
                <blockquote class="quoted-text">“{item.quotedPostText[lang]}”</blockquote>
              </div>
            )}

            {/* Cat editorial commentary */}
            <div class="sns-editorial-box">
              <div class="editorial-label">{commentaryLabel[lang]}</div>
              <p class="editorial-text">{item.editorialCommentary[lang]}</p>
            </div>

            {/* Action button linking directly to the official channel or post */}
            <div class="sns-card-footer">
              <a href={rawTargetUrl} target="_blank" rel="noopener noreferrer" class="sns-hub-action-btn racing-font" style={`--btn-color: ${badge.color}; --btn-border: ${badge.border};`}>
                <span class="btn-icon">{badge.icon}</span>
                <span>{actionLabel}</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}

{/* Twitter widgets.js and dynamic embed processor */}
<script is:inline>
  (function() {
    function loadTwitterWidgets() {
      if (window.twttr && window.twttr.widgets) {
        window.twttr.widgets.load();
      } else if (!document.getElementById('twitter-wjs')) {
        const script = document.createElement('script');
        script.id = 'twitter-wjs';
        script.src = 'https://platform.twitter.com/widgets.js';
        script.async = true;
        script.charset = 'utf-8';
        document.head.appendChild(script);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadTwitterWidgets);
    } else {
      loadTwitterWidgets();
    }
    document.addEventListener('astro:page-load', loadTwitterWidgets);
  })();
</script>

<style>
  .sns-citations-section {
    margin-top: 2.8rem;
    background: linear-gradient(165deg, rgba(21, 25, 34, 0.96), rgba(27, 32, 44, 0.96));
    border: 1px solid rgba(29, 155, 240, 0.35);
    border-radius: 1rem;
    padding: 1.6rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .sns-section-header {
    margin-bottom: 1.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.85rem;
  }

  .sns-section-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  .sns-section-subtitle {
    font-size: 0.82rem;
    color: var(--text-secondary, #8b949e);
    line-height: 1.5;
    margin: 0;
  }

  .sns-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.4rem;
    align-items: stretch;
  }

  .sns-cite-card {
    background: rgba(13, 15, 20, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.95rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    transition: all 0.2s ease;
  }

  .sns-cite-card:hover {
    border-color: rgba(29, 155, 240, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .sns-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.75rem;
  }

  .sns-author-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sns-avatar-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.1rem;
    border: 1px solid transparent;
    flex-shrink: 0;
  }

  .sns-account-name {
    font-weight: 800;
    font-size: 0.95rem;
    color: #fff;
    line-height: 1.3;
  }

  .sns-handle {
    font-size: 0.8rem;
    color: #58a6ff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .sns-handle:hover {
    color: #79c0ff;
    text-decoration: underline;
  }

  .sns-top-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sns-platform-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* Embedded rich media stage */
  .sns-embed-stage {
    width: 100%;
    display: flex;
    justify-content: center;
    border-radius: 0.75rem;
    margin: 0.2rem 0;
    background: transparent;
  }

  .sns-x-tweet-embed {
    width: 100%;
    max-width: 550px;
    display: flex;
    justify-content: center;
    background: transparent;
  }

  .sns-x-tweet-embed blockquote.twitter-tweet {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin: 0.5rem 0;
    color: #e6edf3;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .sns-ig-embed {
    width: 100%;
    max-width: 540px;
    background: #fff;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .ig-embed-iframe {
    width: 100%;
    min-height: 520px;
    display: block;
    border: 0;
  }

  .sns-yt-embed {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .yt-embed-iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Quoted box */
  .sns-quoted-box {
    background: rgba(255, 255, 255, 0.04);
    border-left: 3px solid #58a6ff;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.75rem 1rem;
  }

  .quoted-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #79c0ff;
    margin-bottom: 0.35rem;
    letter-spacing: 0.02em;
  }

  .quoted-text {
    font-size: 0.86rem;
    color: #e6edf3;
    line-height: 1.65;
    margin: 0;
    font-style: italic;
  }

  /* Cat editorial box */
  .sns-editorial-box {
    background: rgba(255, 183, 3, 0.07);
    border: 1px solid rgba(255, 183, 3, 0.22);
    border-radius: 0.65rem;
    padding: 0.9rem 1.05rem;
    flex-grow: 1;
  }

  .editorial-label {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--accent-gold);
    margin-bottom: 0.35rem;
    letter-spacing: 0.03em;
  }

  .editorial-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .sns-card-footer {
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .sns-hub-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--btn-border, rgba(255, 255, 255, 0.15));
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sns-hub-action-btn:hover {
    background: var(--btn-color, #1d9bf0);
    border-color: var(--btn-color, #1d9bf0);
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transform: translateY(-1px);
  }

  .btn-icon {
    font-size: 1rem;
  }
</style>
