---
import type { SnsCiteItem } from '../data/articles';
import type { Lang } from '../data/i18n';

interface Props {
  citations?: SnsCiteItem[];
  lang: Lang;
}

const { citations = [], lang } = Astro.props;

const sectionTitle: Record<Lang, string> = {
  ja: '📱 公式SNSポスト ＆ 猫編集部のディテール解説',
  ca: '📱 Publicacions Oficials de Xarxes Socials i Anàlisi en Detall',
  en: '📱 Official Social Media Posts & Paddock Breakdown'
};

const commentaryLabel: Record<Lang, string> = {
  ja: '🐾 猫編集部のポスト解説',
  ca: '🐾 Anàlisi de la publicació',
  en: '🐾 Paddock Notes on this Post'
};

const viewPostLabel: Record<Lang, string> = {
  ja: '公式SNSで開く ↗',
  ca: 'Obrir a la xarxa oficial ↗',
  en: 'Open on Official SNS ↗'
};

function getPlatformBadge(platform: SnsCiteItem['platform']) {
  switch (platform) {
    case 'X':
      return { icon: '𝕏', label: 'X (Twitter)', color: '#1d9bf0', bg: 'rgba(29, 155, 240, 0.14)' };
    case 'Instagram':
      return { icon: '📸', label: 'Instagram', color: '#e1306c', bg: 'rgba(225, 48, 108, 0.14)' };
    case 'YouTube':
      return { icon: '▶️', label: 'YouTube', color: '#ff0000', bg: 'rgba(255, 0, 0, 0.14)' };
    default:
      return { icon: '🌐', label: 'Official SNS', color: '#ffb703', bg: 'rgba(255, 183, 3, 0.14)' };
  }
}

function getXStatusUrl(url?: string): string | null {
  if (!url) return null;
  const m = url.match(/^https?:\/\/(?:www\.)?(?:twitter\.com|x\.com)\/([^/]+)\/status\/(\d+)/i);
  if (!m) return null;
  // twitter-tweet widget requires twitter.com or x.com status URL
  return `https://twitter.com/${m[1]}/status/${m[2]}`;
}

function getXProfileUrl(url?: string, handle?: string): string | null {
  if (url) {
    const m = url.match(/^https?:\/\/(?:www\.)?(?:twitter\.com|x\.com)\/([A-Za-z0-9_]+)\/?$/i);
    if (m) return `https://twitter.com/${m[1]}`;
  }
  if (handle) {
    const m2 = handle.match(/@([A-Za-z0-9_]+)/);
    if (m2) return `https://twitter.com/${m2[1]}`;
  }
  return null;
}

function getInstagramEmbedUrl(url?: string): string | null {
  if (!url) return null;
  const postMatch = url.match(/instagram\.com\/(?:p|reel)\/([A-Za-z0-9_-]+)/i);
  if (postMatch) {
    return `https://www.instagram.com/p/${postMatch[1]}/embed/captioned/`;
  }
  const profMatch = url.match(/instagram\.com\/([A-Za-z0-9_.]+)\/?$/i);
  if (profMatch && !['p', 'reel', 'explore', 'stories'].includes(profMatch[1].toLowerCase())) {
    return `https://www.instagram.com/${profMatch[1]}/embed/`;
  }
  return null;
}

function getYouTubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  const watchMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([A-Za-z0-9_-]{11})/i);
  if (watchMatch) {
    return `https://www.youtube.com/embed/${watchMatch[1]}`;
  }
  return null;
}
---

{citations && citations.length > 0 && (
  <section class="sns-citations-section">
    <div class="sns-section-header">
      <h3 class="sns-section-title">{sectionTitle[lang]}</h3>
    </div>

    <div class="sns-cards-grid">
      {citations.map((item) => {
        const badge = getPlatformBadge(item.platform);
        const rawTargetUrl = item.postUrl || item.url;
        const xStatusUrl = getXStatusUrl(item.postUrl) || getXStatusUrl(item.url);
        const igEmbedUrl = getInstagramEmbedUrl(item.postUrl) || getInstagramEmbedUrl(item.url);
        const ytEmbedUrl = getYouTubeEmbedUrl(item.postUrl) || getYouTubeEmbedUrl(item.url);
        const xProfileUrl = !xStatusUrl && item.platform === 'X' ? getXProfileUrl(rawTargetUrl, item.handle) : null;

        return (
          <div class="sns-cite-card">
            <div class="sns-card-top">
              <div class="sns-author-meta">
                <span class="sns-avatar-icon" style={`background: ${badge.bg}; color: ${badge.color}; border-color: ${badge.color}44;`}>
                  {badge.icon}
                </span>
                <div>
                  <div class="sns-account-name">{item.accountName}</div>
                  <a href={rawTargetUrl} target="_blank" rel="noopener noreferrer" class="sns-handle racing-font">
                    {item.handle}
                  </a>
                </div>
              </div>

              <div class="sns-top-right">
                <div class="sns-platform-tag" style={`background: ${badge.bg}; color: ${badge.color};`}>
                  <span>{badge.icon}</span>
                  <span>{badge.label}</span>
                </div>
                <a href={rawTargetUrl} target="_blank" rel="noopener noreferrer" class="sns-action-link racing-font">
                  {viewPostLabel[lang]}
                </a>
              </div>
            </div>

            {/* Embedded Rich Social Post Media (X Post Widget, Instagram Post Embed, or YouTube Player) */}
            <div class="sns-embed-stage">
              {xStatusUrl ? (
                <div class="sns-x-tweet-embed">
                  <blockquote class="twitter-tweet" data-theme="dark" data-dnt="true" data-align="center">
                    <a href={xStatusUrl}></a>
                  </blockquote>
                </div>
              ) : igEmbedUrl ? (
                <div class="sns-ig-embed">
                  <iframe
                    src={igEmbedUrl}
                    class="ig-embed-iframe"
                    frameborder="0"
                    scrolling="no"
                    allowtransparency="true"
                    loading="lazy"
                    title={`${item.accountName} Instagram Post`}
                  ></iframe>
                </div>
              ) : ytEmbedUrl ? (
                <div class="sns-yt-embed">
                  <iframe
                    src={ytEmbedUrl}
                    class="yt-embed-iframe"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    title={`${item.accountName} YouTube Video`}
                  ></iframe>
                </div>
              ) : xProfileUrl ? (
                <div class="sns-x-timeline-embed">
                  <a
                    class="twitter-timeline"
                    data-theme="dark"
                    data-height="460"
                    data-chrome="noheader nofooter"
                    href={xProfileUrl}
                  >
                    Posts by {item.handle}
                  </a>
                </div>
              ) : null}
            </div>

            <div class="sns-editorial-box">
              <div class="editorial-label">{commentaryLabel[lang]}</div>
              <p class="editorial-text">{item.editorialCommentary[lang]}</p>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}

<style>
  .sns-citations-section {
    margin-top: 2.5rem;
    background: linear-gradient(165deg, rgba(21, 25, 34, 0.95), rgba(27, 32, 44, 0.95));
    border: 1px solid rgba(29, 155, 240, 0.32);
    border-radius: 1rem;
    padding: 1.6rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .sns-section-header {
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .sns-section-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #fff;
  }

  .sns-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.35rem;
    align-items: start;
  }

  .sns-cite-card {
    background: rgba(13, 15, 20, 0.78);
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }

  .sns-cite-card:hover {
    border-color: rgba(29, 155, 240, 0.45);
  }

  .sns-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sns-author-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sns-avatar-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.05rem;
    border: 1px solid transparent;
  }

  .sns-account-name {
    font-weight: 800;
    font-size: 0.95rem;
    color: #fff;
  }

  .sns-handle {
    font-size: 0.8rem;
    color: #58a6ff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .sns-top-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .sns-platform-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
  }

  .sns-embed-stage {
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .sns-x-tweet-embed,
  .sns-x-timeline-embed {
    width: 100%;
    max-width: 550px;
    min-height: 220px;
    display: flex;
    justify-content: center;
  }

  .sns-ig-embed {
    width: 100%;
    max-width: 540px;
    background: #fff;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .ig-embed-iframe {
    width: 100%;
    min-height: 580px;
    display: block;
    border: 0;
  }

  .sns-yt-embed {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
  }

  .yt-embed-iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sns-editorial-box {
    background: rgba(255, 183, 3, 0.07);
    border: 1px solid rgba(255, 183, 3, 0.22);
    border-radius: 0.65rem;
    padding: 0.9rem 1.05rem;
  }

  .editorial-label {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--accent-gold);
    margin-bottom: 0.35rem;
    letter-spacing: 0.03em;
  }

  .editorial-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .sns-action-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: #58a6ff;
    background: rgba(29, 155, 240, 0.12);
    border: 1px solid rgba(29, 155, 240, 0.3);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    transition: all 0.15s ease;
  }

  .sns-action-link:hover {
    background: rgba(29, 155, 240, 0.22);
    color: #fff;
  }
</style>
