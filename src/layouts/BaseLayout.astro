---
import { UI_TEXT, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  initialLang?: Lang;
  canonicalPath?: string;
}

const {
  title = UI_TEXT.siteTitle.ja,
  description = UI_TEXT.siteTagline.ja,
  initialLang = 'ja',
  canonicalPath = '/'
} = Astro.props;
---

<!doctype html>
<html lang={initialLang} data-lang={initialLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Multi-language SEO & Fundació .cat compliance hreflang -->
    <link rel="canonical" href={`https://honda.cat${canonicalPath}`} />
    <link rel="alternate" hreflang="ja" href={`https://honda.cat${canonicalPath}`} />
    <link rel="alternate" hreflang="ca" href={`https://honda.cat/ca/`} />
    <link rel="alternate" hreflang="en" href={`https://honda.cat/en/`} />
    <link rel="alternate" hreflang="x-default" href={`https://honda.cat${canonicalPath}`} />

    <!-- Google Fonts: Racing & Multi-script typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,600;0,700;1,700&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Instant Language Restore from Web Storage (localStorage) before First Paint -->
    <script is:inline define:vars={{ initialLang }}>
      (function () {
        const STORAGE_KEY = 'honda_cat_preferred_lang';
        const validLangs = ['ja', 'ca', 'en'];
        try {
          const urlParams = new URLSearchParams(window.location.search);
          const queryLang = urlParams.get('lang');
          if (queryLang && validLangs.includes(queryLang)) {
            localStorage.setItem(STORAGE_KEY, queryLang);
            document.documentElement.setAttribute('data-lang', queryLang);
            document.documentElement.setAttribute('lang', queryLang);
            return;
          }

          const savedLang = localStorage.getItem(STORAGE_KEY);
          if (savedLang && validLangs.includes(savedLang)) {
            document.documentElement.setAttribute('data-lang', savedLang);
            document.documentElement.setAttribute('lang', savedLang);
          } else {
            // Respect route initialLang (Default: 'ja' as requested)
            document.documentElement.setAttribute('data-lang', initialLang || 'ja');
            document.documentElement.setAttribute('lang', initialLang || 'ja');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-lang', initialLang || 'ja');
        }
      })();
    </script>

    <style is:global>
      :root {
        --bg-primary: #0d0f14;
        --bg-secondary: #151922;
        --bg-card: #1b202c;
        --bg-card-hover: #222838;
        --text-primary: #f4f6fb;
        --text-secondary: #a8b3cf;
        --text-muted: #707d9c;
        --accent-red: #e63946;
        --accent-gold: #ffb703;
        --accent-teal: #2a9d8f;
        --accent-naoko: #c77dff;
        --accent-pink: #ff758f;
        --border-subtle: rgba(255, 255, 255, 0.09);
        --max-w: 1220px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.65;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background-image:
          radial-gradient(circle at 12% 8%, rgba(230, 57, 70, 0.12), transparent 35%),
          radial-gradient(circle at 88% 18%, rgba(199, 125, 255, 0.1), transparent 35%);
      }

      /* Multi-language instant visibility system powered by html[data-lang] */
      [data-i18n] {
        display: none !important;
      }
      html[data-lang='ja'] [data-i18n='ja'] {
        display: revert !important;
      }
      html[data-lang='ca'] [data-i18n='ca'] {
        display: revert !important;
      }
      html[data-lang='en'] [data-i18n='en'] {
        display: revert !important;
      }

      .container {
        width: 100%;
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .racing-font {
        font-family: 'Chakra Petch', 'Noto Sans JP', sans-serif;
      }

      /* Checkered racing stripe utility */
      .checkered-stripe {
        height: 8px;
        background-image: conic-gradient(
          #ffffff 90deg,
          #151922 90deg 180deg,
          #ffffff 180deg 270deg,
          #151922 270deg
        );
        background-size: 16px 16px;
        opacity: 0.85;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.03em;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.4rem;
        border-radius: 0.6rem;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--accent-red), #d62828);
        color: #fff;
        box-shadow: 0 4px 16px rgba(230, 57, 70, 0.35);
      }
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 22px rgba(230, 57, 70, 0.5);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        color: var(--text-primary);
        border-color: rgba(255, 255, 255, 0.16);
      }
      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.12);
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <div class="checkered-stripe"></div>
    <slot />

    <!-- Global Language Switcher & Web Storage Sync Controller -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'honda_cat_preferred_lang';

        function applyLanguage(lang, persist = true) {
          if (!['ja', 'ca', 'en'].includes(lang)) return;
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.setAttribute('lang', lang);

          if (persist) {
            try {
              localStorage.setItem(STORAGE_KEY, lang);
            } catch (e) {}
          }

          // Update active state on all language switcher buttons
          document.querySelectorAll('[data-lang-switch]').forEach((btn) => {
            const btnLang = btn.getAttribute('data-lang-switch');
            if (btnLang === lang) {
              btn.classList.add('active');
              btn.setAttribute('aria-pressed', 'true');
            } else {
              btn.classList.remove('active');
              btn.setAttribute('aria-pressed', 'false');
            }
          });

          // Show toast feedback when manually switched
          if (persist && window.__hondaCatToastReady) {
            const toast = document.getElementById('lang-memory-toast');
            if (toast) {
              const msgs = {
                ja: '🇯🇵 日本語に設定しました（次回からも自動で日本語が表示されます）',
                ca: '🏴󠁥󠁳󠁣󠁴󠁿 Idioma canviat a Català (es recordarà per a properes visites)',
                en: '🇬🇧 Language set to English (saved in browser for future visits)'
              };
              toast.textContent = msgs[lang] || msgs.ja;
              toast.classList.add('show');
              clearTimeout(window.__hondaCatToastTimer);
              window.__hondaCatToastTimer = setTimeout(() => {
                toast.classList.remove('show');
              }, 3200);
            }
          }
        }

        window.setHondaCatLang = function (lang) {
          applyLanguage(lang, true);
        };

        document.addEventListener('DOMContentLoaded', () => {
          const currentLang = document.documentElement.getAttribute('data-lang') || 'ja';
          applyLanguage(currentLang, false);
          window.__hondaCatToastReady = true;

          document.querySelectorAll('[data-lang-switch]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const targetLang = btn.getAttribute('data-lang-switch');
              applyLanguage(targetLang, true);
            });
          });
        });
      })();
    </script>
  </body>
</html>
