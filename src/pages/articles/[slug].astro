---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CatDialogueBox from '../../components/CatDialogueBox.astro';
import SnsEmbedSection from '../../components/SnsEmbedSection.astro';
import MaintenanceDiagram from '../../components/MaintenanceDiagram.astro';
import ChuruSupportCard from '../../components/ChuruSupportCard.astro';
import Footer from '../../components/Footer.astro';
import { getAllArticles, type ArticleData } from '../../data/articles';
import { CAT_TEAM, UI_TEXT, type Lang } from '../../data/i18n';

export function getStaticPaths() {
  const articles = getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: ArticleData;
}

const { article } = Astro.props;
const cat = CAT_TEAM[article.featuredCat] || CAT_TEAM.marc;
const langs: Lang[] = ['ja', 'ca', 'en'];
const catLabel = UI_TEXT.categories[article.category];
const typeLabel = UI_TEXT.articleTypes[article.articleType];
const articleActiveNav = article.category === 'kyushu' ? 'kyushu' : 'home';
---

<BaseLayout
  title={`${article.locales.ja.title} | HONDA.CAT`}
  description={article.locales.ja.summary}
  initialLang="ja"
  canonicalPath={`/articles/${article.slug}/`}
>
  <Header activeNav={articleActiveNav} />

  <main class="article-main">
    <div class="container article-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">
          <span data-i18n="ja">ホーム</span>
          <span data-i18n="ca">Inici</span>
          <span data-i18n="en">Home</span>
        </a>
        <span class="bc-sep">/</span>
        <a href="/articles/">
          <span data-i18n="ja">記事一覧</span>
          <span data-i18n="ca">Cròniques</span>
          <span data-i18n="en">Articles</span>
        </a>
        <span class="bc-sep">/</span>
        <span class="bc-current" aria-current="page">
          <span data-i18n="ja">{article.locales.ja.title}</span>
          <span data-i18n="ca">{article.locales.ca.title}</span>
          <span data-i18n="en">{article.locales.en.title}</span>
        </span>
      </nav>

      {langs.map((lang) => {
        const content = article.locales[lang];
        return (
          <article class="article-detail" data-i18n={lang}>
            <header class="detail-header">
              <div class="detail-badges">
                <span class="badge" style={`background: ${cat.badgeColor}; color: #fff;`}>
                  {catLabel[lang]}
                </span>
                <span class="badge" style="background: rgba(255, 183, 3, 0.16); color: var(--accent-gold);">
                  {typeLabel[lang]}
                </span>
                <span class="badge" style="background: rgba(255, 255, 255, 0.08);">
                  📅 {article.publishedAt}
                </span>
              </div>

              <h1 class="detail-title">{content.title}</h1>
              <p class="detail-subtitle">{content.subtitle}</p>

              <div class="event-meta-bar">
                <div class="meta-item">
                  <strong>📍 Venue:</strong> {article.eventMeta.venue[lang]}
                </div>
                <div class="meta-item">
                  <strong>🌤️ Condition:</strong> {article.eventMeta.weather[lang]}
                </div>
              </div>
            </header>

            <div class="detail-hero">
              <img src={article.heroImage} alt={content.title} class="detail-hero-img" />
            </div>

            <div class="highlight-banner">
              <span class="hl-badge racing-font">⚡ PADDOCK SPOTLIGHT</span>
              <p>{content.highlightPoint}</p>
            </div>

            <div class="detail-sections">
              {content.sections.map((sec, idx) => (
                <>
                  <section class="content-section">
                    <h2>{sec.heading}</h2>
                    <p>{sec.body}</p>
                  </section>
                  {article.category === 'maintenance' && idx === 0 && (
                    <MaintenanceDiagram slug={article.slug} lang={lang} contentDiagram={content.diagram} />
                  )}
                </>
              ))}
            </div>

            {content.results && content.results.length > 0 && (
              <div class="results-box">
                <h3 class="results-title">🏁 {content.resultTableTitle}</h3>
                <div class="table-scroll">
                  <table class="results-table">
                    <thead>
                      <tr>
                        <th>POS / ITEM</th>
                        <th>RIDER / TEAM / FOCUS</th>
                        <th>MACHINE / SPEC</th>
                        <th>TIME / NOTE</th>
                      </tr>
                    </thead>
                    <tbody>
                      {content.results.map((row) => (
                        <tr>
                          <td class="pos-cell racing-font">{row.pos}</td>
                          <td class="team-cell">{row.riderOrTeam}</td>
                          <td>{row.machine}</td>
                          <td class="note-cell">{row.timeOrNote}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            <SnsEmbedSection citations={article.snsCitations} lang={lang} />

            <CatDialogueBox dialogues={content.catDialogues} lang={lang} />

            <ChuruSupportCard variant="card" />

            {article.factCheck?.sources && article.factCheck.sources.length > 0 && (
              <aside class="related-links-box">
                <div class="related-links-title">
                  {lang === 'ja' && '🔗 関連公式サイト・リザルト参照先'}
                  {lang === 'ca' && '🔗 Enllaços Oficials i Resultats'}
                  {lang === 'en' && '🔗 Official Websites & Results Links'}
                </div>
                <ul class="fact-sources">
                  {article.factCheck.sources.map((src) => (
                    <li>
                      <a href={src.url} target="_blank" rel="noopener noreferrer">{src.title} ↗</a>
                    </li>
                  ))}
                </ul>
              </aside>
            )}
          </article>
        );
      })}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-main {
    padding: 2.5rem 0 4rem;
  }

  .article-container {
    max-width: 900px;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--accent-gold);
    transition: color 0.15s ease;
  }

  .breadcrumb a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .bc-sep {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .bc-current {
    color: var(--text-secondary);
    max-width: 450px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail-header {
    margin-bottom: 2rem;
  }

  .detail-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .detail-title {
    font-size: clamp(1.6rem, 3.2vw, 2.35rem);
    font-weight: 900;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .detail-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .event-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    padding: 0.85rem 1.15rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .meta-item strong {
    color: var(--accent-gold);
  }

  .detail-hero {
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    margin-bottom: 1.75rem;
    background: #10131a;
  }

  .detail-hero-img {
    width: 100%;
    height: 100%;
    max-height: 410px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .detail-hero-caption {
    padding: 0.6rem 1rem;
    font-size: 0.76rem;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.55);
    border-top: 1px solid var(--border-subtle);
  }

  .highlight-banner {
    background: linear-gradient(135deg, rgba(230, 57, 70, 0.16), rgba(255, 183, 3, 0.12));
    border-left: 4px solid var(--accent-gold);
    padding: 1.1rem 1.35rem;
    border-radius: 0 0.75rem 0.75rem 0;
    margin-bottom: 2.2rem;
  }

  .hl-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.06em;
    margin-bottom: 0.25rem;
  }

  .highlight-banner p {
    font-weight: 700;
    font-size: 0.98rem;
  }

  .detail-sections {
    display: flex;
    flex-direction: column;
    gap: 1.85rem;
  }

  .content-section h2 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.65rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent-red);
  }

  .content-section p {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .results-box {
    margin-top: 2.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    padding: 1.5rem;
  }

  .results-title {
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--accent-gold);
  }

  .table-scroll {
    overflow-x: auto;
  }

  .results-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .results-table th,
  .results-table td {
    padding: 0.75rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }

  .results-table th {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .pos-cell {
    font-weight: 700;
    color: var(--accent-gold);
    white-space: nowrap;
  }

  .team-cell {
    font-weight: 700;
    color: #fff;
  }

  .note-cell {
    color: var(--text-secondary);
  }

  .related-links-box {
    margin-top: 2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    padding: 1.1rem 1.35rem;
  }

  .related-links-title {
    font-weight: 700;
    font-size: 0.84rem;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
  }

  .fact-sources {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.35rem;
    font-size: 0.82rem;
  }

  .fact-sources a {
    color: var(--accent-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
