---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CatTeamSection from '../components/CatTeamSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="猫編集部紹介（マルク・スズカ・ナオミ） | HONDA.CAT"
  description="二足歩行で世界のパドックと日本のサーキットを駆け回る3匹の猫ジャーナリスト＆メカニック（マルク・スズカ・ナオミ）のプロフィール紹介。"
  initialLang="ja"
  canonicalPath="/cats/"
>
  <Header activeNav="cats" />

  <main class="page-main">
    <CatTeamSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-main {
    padding-bottom: 2rem;
  }
</style>
